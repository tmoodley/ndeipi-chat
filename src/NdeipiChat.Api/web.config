<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- After sign-in Clerk reloads the mobile sign-in page with its handshake token in the
               query string, which is longer than IIS's 2 KB default (IIS answers 404.15).
               Keep in step with Kestrel's MaxRequestLineSize in Program.cs. -->
          <requestLimits maxQueryString="16384" maxUrl="16384" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
