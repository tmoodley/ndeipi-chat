<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- site4now runs apps in a shared IIS app pool, and IIS refuses to mix in-process and
         out-of-process apps in one pool (HTTP 500.34). Out-of-process can share a pool. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <UserSecretsId>3a10d4c6-ca3a-43b6-bec2-49ac0a2ba6e6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NdeipiChat.Contracts\NdeipiChat.Contracts.csproj" />
    <ProjectReference Include="..\NdeipiChat.Web\NdeipiChat.Web.csproj" />
  </ItemGroup>

  <!--
    Signs sub-app bundles with the publisher key (SRS NFR-02-01, docs/sub-apps.md), once they're in
    the publish folder and before anything deploys it: folder, FTP and Web Deploy publishes all
    deploy from PublishDir. The key never leaves this machine; only the signatures are published.
    Key: -p:SubAppPublisherKey=…, or NDEIPI_SUBAPP_KEY, or ~/.ndeipi/subapp-publisher.key.
  -->
  <PropertyGroup>
    <SubAppPublisherKey Condition="'$(SubAppPublisherKey)' == ''">$(NDEIPI_SUBAPP_KEY)</SubAppPublisherKey>
    <SubAppPublisherKey Condition="'$(SubAppPublisherKey)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))\.ndeipi\subapp-publisher.key</SubAppPublisherKey>
    <_SubAppSigner>$(MSBuildThisFileDirectory)..\..\tools\NdeipiChat.SubAppSigner\NdeipiChat.SubAppSigner.csproj</_SubAppSigner>
  </PropertyGroup>

  <Target Name="SignSubAppBundles" AfterTargets="ComputeAndCopyFilesToPublishDirectory">
    <Error Condition="!Exists('$(SubAppPublisherKey)') And '$(Configuration)' == 'Release' And '$(AllowUnsignedSubApps)' != 'true'"
           Text="No sub-app publisher key at $(SubAppPublisherKey), so sub-apps can't be signed and the shell would refuse them. Set SubAppPublisherKey or NDEIPI_SUBAPP_KEY, or pass -p:AllowUnsignedSubApps=true." />
    <Warning Condition="!Exists('$(SubAppPublisherKey)') And ('$(Configuration)' != 'Release' Or '$(AllowUnsignedSubApps)' == 'true')"
             Text="Sub-apps are published unsigned; shells that require signatures will refuse them." />
    <Exec Condition="Exists('$(SubAppPublisherKey)')"
          Command="dotnet run --project &quot;$(_SubAppSigner)&quot; -c Release -- sign --site &quot;$(PublishDir)wwwroot&quot; --key &quot;$(SubAppPublisherKey)&quot; --out &quot;$(PublishDir)subapp-signatures.json&quot;" />
  </Target>
</Project>
