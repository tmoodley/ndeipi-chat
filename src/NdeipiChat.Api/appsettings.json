{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Chat": "Server=(localdb)\\MSSQLLocalDB;Database=NdeipiChat;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Clerk": {
    "Authority": "https://definite-monarch-2384.clerk.accounts.dev",
    "PublishableKey": "pk_test_ZGVmaW5pdGUtbW9uYXJjaC0yMzg0LmNsZXJrLmFjY291bnRzLmRldiQ",
    "SecretKey": "",
    "AuthorizedParties": [],
    "SessionTokenTemplate": ""
  },
  "MobileAuth": {
    // The phone and Mac apps (custom scheme), the web app, and the Windows app (a listener on the
    // user's own PC while they sign in in their browser).
    "RedirectUris": [ "ndeipichat://auth", "https://chat.ndeipi.com/signin/callback", "http://127.0.0.1:47832/auth" ]
  },
  "Tokens": {
    "Chains": [],
    "Known": [
      {
        "Chain": "polygon",
        "Symbol": "NDEIPI",
        "Standard": "erc20",
        "ContractAddress": "0xd8d401df77080baa60718fa0b1f775eea272ab3b",
        "Decimals": 18
      }
    ],
    "QueuePollInterval": "00:00:02"
  },
  "Livestock": {
    "ImageStoragePath": "App_Data/livestock-images",
    "MinFaceShortSide": 1080,
    "MinFlankShortSide": 720,
    "BreedConfidenceThreshold": 0.9,
    "Claude": {
      "ApiKey": "",
      "Model": "claude-opus-5"
    },
    "Muzzle": {
      "ModelPath": "",
      "InputWidth": 224,
      "InputHeight": 224,
      "SimilarityThreshold": 0.9
    }
  },
  "Launcher": {
    "Apps": {
      // Loaded by the web shell on first use, not built in: see src/NdeipiChat.SubApps.Inventory.
      "inventory": {
        "Title": "Inventory",
        "Description": "Keep count of your stock and where it's kept.",
        "Icon": "📦",
        "Route": "apps/inventory",
        "Assembly": "NdeipiChat.SubApps.Inventory",
        "Scopes": [ "inventory" ],
        "Order": 60
      },
      "events": {
        "Title": "Events",
        "Description": "Find events, buy tickets, and scan them at the gate.",
        "Icon": "🎟️",
        "Route": "apps/events",
        "Assembly": "NdeipiChat.SubApps.Events",
        "Scopes": [ "events", "wallet" ],
        "Order": 55
      },
      "donations": {
        "Title": "Donations",
        "Description": "Give to community campaigns in a tap, and earn Believe Points.",
        "Icon": "💚",
        "Route": "apps/donations",
        "Assembly": "NdeipiChat.SubApps.Donations",
        "Scopes": [ "donations", "wallet", "points" ],
        "Order": 58
      },
      "gigs": {
        "Title": "Gigs",
        "Description": "Find work nearby, or hire someone, and pay in NdeipiCoin.",
        "Icon": "🧰",
        "Route": "apps/gigs",
        "Assembly": "NdeipiChat.SubApps.Gigs",
        "Scopes": [ "gigs", "chat", "tokens", "location" ],
        "Order": 56
      },
      "pos": {
        "Title": "POS",
        "Description": "Sell in your shop: a till with barcode scanning, shifts, receipts and stock.",
        "Icon": "🛒",
        "Route": "apps/pos",
        "Assembly": "NdeipiChat.SubApps.Pos",
        "Scopes": [ "pos", "chat", "camera" ],
        "Order": 57
      }
    }
  },
  "Gigs": {
    // Gigs are priced and paid in this token; it must be listed under Tokens:Known.
    "TokenSymbol": "NDEIPI"
  },
  "Social": {
    "MediaPath": "App_Data/post-media",
    "PublicBaseUrl": "https://chat.ndeipi.com",
    "Nft": {
      "Chain": "",
      "ContractAddress": "",
      "Standard": "erc721",
      "Symbol": "NDPOST",
      "CollectionName": "Ndeipi Posts"
    }
  },
  "Bridge": {
    "BaseUrl": "https://api.sandbox.bridge.xyz/v0/",
    "ApiKey": "",
    "WebhookPublicKey": "",
    "WalletChain": "solana",
    "Currency": "usdc",
    "MaxTransferAmount": 10000,
    "PollInterval": "00:00:30"
  }
}
