@* The Market sub-app (SRS "Livestock Networking, Marketplace, and Financial Micro App", phase 1):
   livestock listed in the group chats you're in, with photos, prices in kwacha, hashtags, and cash
   or barter offers; selling posts a listing into one of your groups. Opened from the launcher, a
   chat's "+" panel ("sell={chat}"), a listing card ("listing={id}&chat={chat}&offer=1") or a
   hashtag ("tag=goats"). *@
@attribute [SubAppRoot(MarketContract.AppId)]

<style>
    .content.embedded header.mk-bar { display: none; }
    .mk .page { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; padding-bottom: 32px; }
    .mk h2 { font-size: 22px; font-weight: 800; margin: 2px 0 0; text-transform: none; color: var(--text); letter-spacing: 0; }
    .mk h3 { font-size: 16px; font-weight: 800; margin: 0; text-transform: none; color: var(--text); letter-spacing: 0; }
    .mk .muted { color: var(--muted); }
    .mk .small { font-size: 13px; }
    .mk-top { display: flex; gap: 8px; align-items: center; padding: 10px 16px 0; max-width: 760px; margin: 0 auto; }
    .mk-top .grow { flex: 1; min-width: 0; }
    .mk-tabs { display: flex; gap: 6px; }
    .mk-tabs button { border-radius: 18px; padding: 8px 14px; font-size: 14px; background: var(--secondary); color: var(--text); box-shadow: none; }
    .mk-tabs button.on { background: var(--brand); color: #fff; font-weight: 700; }
    .mk-card { background: var(--glass-strong, var(--surface)); border: 1px solid var(--glass-border, var(--divider)); border-radius: 18px; box-shadow: var(--shadow, none); padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; color: var(--text); }
    .mk-search { display: flex; gap: 8px; }
    .mk-search input { flex: 1; }
    .mk-chips { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
    .mk-chips button { flex: none; border-radius: 16px; padding: 6px 12px; font-size: 13px; background: var(--secondary); color: var(--text); box-shadow: none; white-space: nowrap; }
    .mk-chips button.on { background: var(--brand); color: #fff; font-weight: 700; }
    .mk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
    .mk-item { text-align: left; padding: 0; overflow: hidden; display: flex; flex-direction: column; cursor: pointer; font: inherit; color: var(--text); background: var(--glass-strong, var(--surface)); border: 1px solid var(--glass-border, var(--divider)); border-radius: 18px; box-shadow: var(--shadow, none); }
    .mk-item .cover { aspect-ratio: 4 / 3; background: #1b1f2a; display: grid; place-items: center; font-size: 46px; position: relative; overflow: hidden; }
    .mk-item .cover img { width: 100%; height: 100%; object-fit: cover; }
    .mk-item .cover .mk-badge { position: absolute; left: 8px; top: 8px; }
    .mk-item .body { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 3px; }
    .mk-item .title { font-weight: 800; line-height: 1.25; }
    .mk-item .price { font-weight: 800; font-size: 18px; color: var(--success); }
    .mk-item .meta { font-size: 12px; color: var(--muted); }
    .mk-badge { display: inline-block; border-radius: 10px; padding: 2px 9px; font-size: 12px; font-weight: 800; background: var(--secondary); color: var(--muted); }
    .mk-badge.ok { background: rgba(31, 169, 113, .9); color: #fff; }
    .mk-badge.wait { background: rgba(255, 196, 0, .9); color: #3a2a00; }
    .mk-badge.bad { background: rgba(229, 72, 77, .9); color: #fff; }
    .mk-gallery { display: grid; grid-auto-flow: column; grid-auto-columns: 86%; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; border-radius: 18px; }
    .mk-gallery.one { grid-auto-columns: 100%; }
    .mk-gallery > * { scroll-snap-align: start; aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; background: #1b1f2a; }
    .mk-gallery img, .mk-gallery video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .mk-price { font-size: 30px; font-weight: 800; color: var(--success); font-variant-numeric: tabular-nums; }
    .mk-facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 14px; margin: 0; }
    .mk-facts dt { color: var(--muted); }
    .mk-facts dd { margin: 0; font-weight: 600; }
    .mk-desc { white-space: pre-wrap; line-height: 1.45; }
    .mk-tag { color: var(--brand); font-weight: 600; cursor: pointer; background: none; border: 0; padding: 0; font: inherit; box-shadow: none; }
    .mk-row { display: flex; gap: 10px; align-items: center; }
    .mk-row .grow { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .mk-row .grow small { color: var(--muted); }
    .mk-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .mk-field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 700; }
    .mk-field input, .mk-field select, .mk-field textarea { font-weight: 500; font-size: 15px; }
    .mk-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .mk-seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; }
    .mk-seg button { background: var(--secondary); color: var(--text); box-shadow: none; padding: 9px; border-radius: 12px; }
    .mk-seg button.on { background: var(--brand); color: #fff; font-weight: 700; }
    .mk-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
    .mk-thumb { width: 76px; height: 76px; border-radius: 12px; overflow: hidden; position: relative; background: #1b1f2a; display: grid; place-items: center; color: #fff; font-size: 22px; }
    .mk-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .mk-thumb button { position: absolute; top: 2px; right: 2px; width: 22px; height: 22px; padding: 0; border-radius: 50%; background: rgba(0, 0, 0, .6); color: #fff; font-size: 13px; box-shadow: none; }
    .mk-add { width: 76px; height: 76px; border-radius: 12px; border: 2px dashed var(--divider); display: grid; place-items: center; font-size: 26px; color: var(--muted); position: relative; overflow: hidden; cursor: pointer; }
    .mk-add input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .mk-offline { background: rgba(255, 196, 0, .18); color: #8A6100; border-radius: 12px; padding: 10px 14px; font-size: 14px; }
    @@media (max-width: 480px) { .mk-two { grid-template-columns: 1fr; } .mk-grid { grid-template-columns: 1fr 1fr; gap: 8px; } .mk-item .price { font-size: 16px; } }
</style>

<div class="mk">
    <header class="bar mk-bar">
        <button class="bar-back link" title="Back" @onclick="BackAsync">‹</button>
        <h1>@Title</h1>
    </header>

    @if (_view is MarketView.Feed or MarketView.Mine)
    {
        <div class="mk-top">
            <nav class="mk-tabs grow">
                <button class="@(_view is MarketView.Feed ? "on" : "")" @onclick="() => Go(new MarketView.Feed())">Market</button>
                <button class="@(_view is MarketView.Mine ? "on" : "")" @onclick="() => Go(new MarketView.Mine())">Mine</button>
            </nav>
            <button class="primary" @onclick="() => Go(new MarketView.Sell())">＋ Sell</button>
        </div>
    }

    <div class="page">
        <CascadingValue Value="this" IsFixed="true">
            @switch (_view)
            {
                case MarketView.Feed f:
                    <Feed @key="f" InitialTag="@f.Tag" />
                    break;
                case MarketView.Listing l:
                    <ListingPage @key="l" Id="l.Id" OfferIn="l.OfferIn" />
                    break;
                case MarketView.Sell s:
                    <Sell @key="s" ChatId="s.ChatId" />
                    break;
                case MarketView.Mine:
                    <Mine />
                    break;
            }
        </CascadingValue>
    </div>
</div>

@code {
    [CascadingParameter] public SubAppContext Context { get; set; } = null!;

    MarketView _view = new MarketView.Feed();
    readonly Stack<MarketView> _history = new();

    public MarketApi Api { get; private set; } = null!;

    protected override void OnInitialized()
    {
        Api = new MarketApi(Context.Api);
        var query = Context.Query.Split('&').Select(p => p.Split('=', 2)).Where(p => p.Length == 2)
            .GroupBy(p => p[0]).ToDictionary(g => g.Key, g => Uri.UnescapeDataString(g.First()[1]));
        Guid? Id(string key) => query.TryGetValue(key, out var v) && Guid.TryParse(v, out var id) ? id : null;

        if (Id("listing") is { } listing)
        {
            _history.Push(new MarketView.Feed());
            _view = new MarketView.Listing(listing, query.ContainsKey("offer") ? Id("chat") : null);
        }
        else if (query.ContainsKey("sell"))
        {
            _history.Push(new MarketView.Feed());
            _view = new MarketView.Sell(Id("sell"));
        }
        else if (query.TryGetValue("tag", out var tag))
        {
            _view = new MarketView.Feed(Hashtags.Normalize(tag));
        }
    }

    string Title => _view switch
    {
        MarketView.Listing => "Listing",
        MarketView.Sell => "Sell livestock",
        MarketView.Mine => "My market",
        _ => "Market"
    };

    public void Go(MarketView view)
    {
        if (view is MarketView.Feed or MarketView.Mine)
            _history.Clear();
        else
            _history.Push(_view);
        _view = view;
        StateHasChanged();
    }

    public void Replace(MarketView view)
    {
        _view = view;
        StateHasChanged();
    }

    public Task BackAsync()
    {
        if (_history.TryPop(out var previous))
        {
            _view = previous;
            StateHasChanged();
            return Task.CompletedTask;
        }
        return Context.NavigateToLauncher();
    }
}
