<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
       x:Class="NdeipiChat.App.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="signin"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate pages:SignInPage}" />

    <!-- The same five places as the web app's dock: Chats, Social, Home, Wallet and More (Me).
         Android's own tab bar is hidden (see App.xaml); each of these pages draws the web's
         floating dock instead (Controls/DockView). Other apps, such as Shamwaris and Herd, open
         as pages over Home. -->
    <TabBar Route="main">
        <Tab Title="Home" Route="home" Icon="tab_home.png">
            <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" />
        </Tab>
        <Tab x:Name="ChatsTab" Title="Chats" Route="chats" Icon="tab_chats.png">
            <ShellContent ContentTemplate="{DataTemplate pages:ChatsPage}" />
        </Tab>
        <Tab x:Name="FeedTab" Title="Social" Route="feed" Icon="tab_feed.png">
            <ShellContent ContentTemplate="{DataTemplate pages:FeedPage}" />
        </Tab>
        <Tab x:Name="WalletTab" Title="Wallet" Route="wallet" Icon="tab_apps.png">
            <ShellContent ContentTemplate="{DataTemplate pages:WalletPage}" />
        </Tab>
        <Tab Title="More" Route="me" Icon="tab_me.png">
            <ShellContent ContentTemplate="{DataTemplate pages:MePage}" />
        </Tab>
    </TabBar>
</Shell>
