<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
       x:Class="NdeipiChat.App.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="signin"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate pages:SignInPage}" />

    <!-- Apps, up to three pinned sub-apps, and Me: Android shows five tabs at most. AppShell.xaml.cs
         shows the tabs of the user's first three pinned apps; the rest open from the launcher. -->
    <TabBar Route="main">
        <Tab Title="Apps" Route="launcher" Icon="tab_apps.png">
            <ShellContent ContentTemplate="{DataTemplate pages:LauncherPage}" />
        </Tab>
        <Tab x:Name="ChatsTab" Title="Chats" Route="chats" Icon="tab_chats.png">
            <ShellContent ContentTemplate="{DataTemplate pages:ChatsPage}" />
        </Tab>
        <Tab x:Name="FeedTab" Title="Feed" Route="feed" Icon="tab_feed.png">
            <ShellContent ContentTemplate="{DataTemplate pages:FeedPage}" />
        </Tab>
        <Tab x:Name="ShamwarisTab" Title="Shamwaris" Route="contacts" Icon="tab_contacts.png">
            <ShellContent ContentTemplate="{DataTemplate pages:ContactsPage}" />
        </Tab>
        <Tab x:Name="HerdTab" Title="Herd" Route="herd" Icon="tab_herd.png" IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate pages:HerdPage}" />
        </Tab>
        <Tab Title="Me" Route="me" Icon="tab_me.png">
            <ShellContent ContentTemplate="{DataTemplate pages:MePage}" />
        </Tab>
    </TabBar>
</Shell>
