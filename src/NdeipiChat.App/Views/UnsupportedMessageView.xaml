<?xml version="1.0" encoding="utf-8" ?>
<views:MessageRow xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:views="clr-namespace:NdeipiChat.App.Views"
                  xmlns:ext="clr-namespace:NdeipiChat.Client.Extensions;assembly=NdeipiChat.Client.Core"
                  x:Class="NdeipiChat.App.Views.UnsupportedMessageView"
                  x:DataType="ext:UnsupportedMessageViewModel">
    <views:MessageRow.Bubble>
        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                StrokeShape="RoundRectangle 20,20,6,20" Padding="15,10" MaximumWidthRequest="280"
                BackgroundColor="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource GlassDark}}">
            <Label Text="{Binding Text}" FontSize="14" FontAttributes="Italic" Style="{StaticResource Muted}" />
        </Border>
    </views:MessageRow.Bubble>
</views:MessageRow>
