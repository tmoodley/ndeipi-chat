<?xml version="1.0" encoding="utf-8" ?>
<!-- A shop's receipt (pos.receipt): a frosted slip with the shop, the total, what was bought and how it was paid. -->
<views:MessageRow xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:views="clr-namespace:NdeipiChat.App.Views"
                  xmlns:ext="clr-namespace:NdeipiChat.Client.Extensions;assembly=NdeipiChat.Client.Core"
                  x:Class="NdeipiChat.App.Views.PosReceiptMessageView"
                  x:DataType="ext:PosReceiptMessageViewModel">
    <views:MessageRow.Bubble>
        <Border StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource GlassBorderLight}, Dark={StaticResource GlassBorderDark}}"
                StrokeShape="RoundRectangle 18"
                Padding="16,14,16,12"
                WidthRequest="280"
                BackgroundColor="{AppThemeBinding Light={StaticResource GlassStrongLight}, Dark={StaticResource GlassStrongDark}}"
                Shadow="{StaticResource SoftShadow}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}">
                        <Label Text="🧾" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding MerchantName}" FontSize="15" FontAttributes="Bold" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding StoreName}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding WhenText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total" FontSize="13" FontAttributes="Bold" VerticalOptions="End"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Lines}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="ext:PosReceiptRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Label}" FontSize="14" LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Label Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Totals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="ext:PosReceiptRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Label}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                <Label Grid.Column="1" Text="{Binding Value}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Payments}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="ext:PosReceiptRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Label}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                <Label Grid.Column="1" Text="{Binding Value}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ReceiptNumber, StringFormat='Receipt {0}'}" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Label Grid.Column="1" Text="{Binding CashierText}" IsVisible="{Binding HasCashier}" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </views:MessageRow.Bubble>
</views:MessageRow>
