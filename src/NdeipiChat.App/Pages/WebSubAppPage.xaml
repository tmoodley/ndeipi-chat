<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.WebSubAppPage"
                     x:DataType="vm:WebSubAppViewModel"
                     Title="{Binding Title}"
                     Shell.TabBarIsVisible="False">
    <!-- A runtime-loaded sub-app: the web shell's sub-app page, in a WebView, once the app has
         checked the bundle's signature itself. See WebSubAppViewModel. -->
    <Grid>
        <WebView x:Name="WebContent" Navigating="OnNavigating" Navigated="OnNavigated" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="32"
                             IsVisible="{Binding IsLoading}" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Brand}" />
            <Label Text="{Binding Title, StringFormat='Checking {0}…'}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}"
                             IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}">
            <Label Text="{Binding ErrorMessage}" HorizontalTextAlignment="Center" />
            <Button Text="Back to your apps" Clicked="OnClose" Style="{StaticResource Primary}" />
        </VerticalStackLayout>
    </Grid>
</pages:ViewModelPage>
