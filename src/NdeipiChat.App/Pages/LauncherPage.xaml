<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.LauncherPage"
                     x:DataType="vm:LauncherViewModel"
                     Title="Ndeipi">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Border IsVisible="{Binding IsOffline}" BackgroundColor="#FFF4D6" StrokeThickness="0" Padding="12,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="You're offline. These are your apps from last time." TextColor="#7A5B00" />
                </Border>

                <!-- Apps open in this session: tap to go back to one, ✕ to close it. -->
                <Label Text="OPEN" Style="{StaticResource SectionHeader}" Margin="0" IsVisible="{Binding HasRunning}" />
                <CollectionView ItemsSource="{Binding Running}" ItemsLayout="HorizontalList" HeightRequest="44" IsVisible="{Binding HasRunning}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubAppItemViewModel">
                            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Margin="0,0,8,0" Padding="12,0,4,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="2">
                                    <Label Text="{Binding Icon}" VerticalOptions="Center" />
                                    <Label Text="{Binding Title}" VerticalOptions="Center" Margin="4,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding LaunchCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Button Text="✕" FontSize="12" Padding="8,0" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                                            Command="{Binding CloseCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Every app the user's manifest allows. ★ pins it; the first three pins get tabs. -->
                <Label Text="YOUR APPS" Style="{StaticResource SectionHeader}" Margin="0" />
                <CollectionView ItemsSource="{Binding Apps}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubAppItemViewModel">
                            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0" Padding="8,14,8,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LaunchCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Label Text="{Binding Icon}" FontSize="32" HorizontalOptions="Center" />
                                    <Label Grid.Row="1" Text="{Binding Title}" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                    <Label Grid.Row="2" Text="Open" FontSize="11" TextColor="{StaticResource Brand}" HorizontalOptions="Center" IsVisible="{Binding IsRunning}" />
                                    <Button Grid.RowSpan="3" Text="☆" FontSize="16" Padding="0" WidthRequest="30" HeightRequest="30"
                                            BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,-10,-4,0"
                                            Command="{Binding TogglePinCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="★" />
                                                <Setter Property="TextColor" Value="#FA9D3B" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="Pinned apps get a tab (up to three). Pull down to refresh your apps." Style="{StaticResource Muted}" FontSize="13" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:ViewModelPage>
