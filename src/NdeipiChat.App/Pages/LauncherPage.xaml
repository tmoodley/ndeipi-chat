<?xml version="1.0" encoding="utf-8" ?>
<!-- Every app the user's manifest allows, as on the web's "All apps". ★ pins it: pinned apps show on
     Home, and the first three get tabs. -->
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.LauncherPage"
                     x:DataType="vm:LauncherViewModel"
                     Title="All apps">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
                <Border Style="{StaticResource Notice}" IsVisible="{Binding IsOffline}">
                    <Label Text="You're offline. These are your apps from last time." TextColor="#8A6100" FontSize="14" />
                </Border>

                <Label Text="Tap to open. ★ pins an app to Home; the first three pinned get tabs." Style="{StaticResource Muted}" FontSize="14" />

                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Apps}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubAppItemViewModel">
                            <Grid FlexLayout.Basis="33.3%" Padding="5">
                                <Border Style="{StaticResource Glass}" Padding="8,16,8,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LaunchCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                                Background="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalOptions="Center">
                                            <Label Text="{Binding Icon}" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Row="1" Text="{Binding Title}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Row="2" Text="Open" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Brand}" HorizontalOptions="Center" IsVisible="{Binding IsRunning}" />
                                        <Button Grid.RowSpan="3" Text="☆" FontSize="16" Padding="0" WidthRequest="30" HeightRequest="30"
                                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,-12,-4,0"
                                                Command="{Binding TogglePinCommand, Source={RelativeSource AncestorType={x:Type vm:LauncherViewModel}}, x:DataType=vm:LauncherViewModel}"
                                                CommandParameter="{Binding .}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Text" Value="★" />
                                                    <Setter Property="TextColor" Value="#F5B324" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:ViewModelPage>
