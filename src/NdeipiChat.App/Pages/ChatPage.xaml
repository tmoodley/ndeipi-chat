<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     xmlns:ext="clr-namespace:NdeipiChat.Client.Extensions;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.ChatPage"
                     x:DataType="vm:ChatViewModel"
                     Title="{Binding Title}"
                     Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,Auto,Auto">

        <CollectionView x:Name="MessageList"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.Header>
                <Button Text="Earlier messages"
                        Command="{Binding LoadOlderCommand}"
                        IsVisible="{Binding HasMore}"
                        Style="{StaticResource LinkButton}"
                        HorizontalOptions="Center"
                        Margin="0,8" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <Label Grid.Row="1"
               Text="{Binding TypingText}"
               IsVisible="{Binding TypingText, Converter={StaticResource IsNotNull}}"
               TextColor="{StaticResource Brand}"
               FontSize="12"
               FontAttributes="Bold"
               Margin="22,0,22,4" />

        <!-- The composer: a frosted pill. "+" opens the actions; it turns into Send once there's text. -->
        <Border Grid.Row="2" Style="{StaticResource Glass}" StrokeShape="RoundRectangle 24" Padding="10,6,6,6" Margin="12,6,12,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Text="+"
                        Command="{Binding ToggleExtensionPanelCommand}"
                        WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                        TextColor="{StaticResource Brand}" FontSize="22" VerticalOptions="End" />
                <Editor Grid.Column="1" Text="{Binding Draft}" Placeholder="Message" AutoSize="TextChanges" MaximumHeightRequest="120" VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="➤"
                        Command="{Binding SendTextCommand}"
                        IsVisible="{Binding Draft, Converter={StaticResource HasText}}"
                        WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                        BackgroundColor="{StaticResource Brand}" TextColor="White" FontSize="17"
                        Shadow="{StaticResource BrandShadow}" VerticalOptions="End" />
            </Grid>
        </Border>

        <!-- The actions: one tile per registered IComposerAction (send money, send tokens...). -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Actions}"
                        IsVisible="{Binding IsExtensionPanelOpen}"
                        SelectionMode="None"
                        HeightRequest="120"
                        Margin="10,0,10,8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ext:IComposerAction">
                    <VerticalStackLayout Padding="6,8" Spacing="6">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RunActionCommand, Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, x:DataType=vm:ChatViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource Glass}" WidthRequest="56" HeightRequest="56" Padding="0" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                            <Label Text="{Binding Glyph}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:ViewModelPage>
