<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.SignInPage"
                     x:DataType="vm:SignInViewModel">
    <Grid RowDefinitions="*,Auto" Padding="28,0,28,48">
        <VerticalStackLayout VerticalOptions="Center" Spacing="14">
            <Border WidthRequest="96" HeightRequest="96" StrokeThickness="0" StrokeShape="RoundRectangle 30" Background="{StaticResource WalletGradient}" HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#5850F0" Opacity="0.35" Radius="24" Offset="0,10" />
                </Border.Shadow>
                <Image Source="appiconfg.png" WidthRequest="70" HeightRequest="70" />
            </Border>
            <Label Text="Ndeipi" Style="{StaticResource PageTitle}" FontSize="34" HorizontalOptions="Center" Margin="0,10,0,0" />
            <Label Text="Chat, send tokens and pay the people you talk to."
                   Style="{StaticResource Muted}" FontSize="16" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Text="Sign in or create account" Command="{Binding SignInCommand}" Style="{StaticResource Primary}" />
                <Label Text="You'll sign in on Ndeipi's secure page, then come straight back." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</pages:ViewModelPage>
