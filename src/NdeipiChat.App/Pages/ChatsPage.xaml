<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:NdeipiChat.App.Pages"
                     xmlns:controls="clr-namespace:NdeipiChat.App.Controls"
                     xmlns:vm="clr-namespace:NdeipiChat.Client.ViewModels;assembly=NdeipiChat.Client.Core"
                     x:Class="NdeipiChat.App.Pages.ChatsPage"
                     ControlTemplate="{StaticResource WithDock}"
                     x:DataType="vm:ChatsViewModel"
                     Title="Chats"
                     Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" Padding="0,20,0,0">
        <Grid ColumnDefinitions="*,Auto" Padding="20,0,16,14">
            <VerticalStackLayout>
                <Label Text="Chats" Style="{StaticResource PageTitle}" />
                <Label Text="Start a new conversation with ＋" Style="{StaticResource Muted}" FontSize="14" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="＋" Style="{StaticResource IconButton}" BackgroundColor="{StaticResource Brand}" TextColor="White" FontSize="22"
                    VerticalOptions="Center" Clicked="OnNewChat" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="0,6" Margin="12,0,12,12">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Conversations}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="32,80" Spacing="8">
                            <Label Text="No chats yet" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Find someone under Shamwaris to start one." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Padding="16,11" ColumnSpacing="12" RowSpacing="3">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:ChatsViewModel}}, x:DataType=vm:ChatsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <controls:AvatarView Grid.RowSpan="2" Text="{Binding Initials}" ImageUrl="{Binding AvatarUrl}" Size="50" VerticalOptions="Center" />

                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Preview}" Style="{StaticResource Muted}" FontSize="14"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource BadgeBorder}" IsVisible="{Binding HasUnread}" HorizontalOptions="End">
                                    <Label Text="{Binding UnreadText}" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Border>
    </Grid>
</pages:ViewModelPage>
