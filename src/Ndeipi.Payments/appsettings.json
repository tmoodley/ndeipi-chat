{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Payments": "Server=(localdb)\\MSSQLLocalDB;Database=NdeipiPayments;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Payments": {
    // "sandbox" or "production". Production refuses to start on simulated providers.
    "Environment": "sandbox",
    // Fiat rail providers ("simulated", or "paypal" and "absa"), and an exchange for crypto features only ("none", "simulated" or "blockfinex").
    "FiatRails": [ "simulated" ],
    "Exchange": "none",
    // Ndeipi Points: the price of one point per currency. A sample for the sandbox; set real prices before launch.
    "Points": {
      "Prices": { "zar": 1.00, "usd": 0.055 }
    },
    "KycProvider": "simulated",
    "IdempotencyWindow": "1.00:00:00",
    "RateLimit": {
      "PermitLimit": 100,
      "Window": "00:00:01"
    },
    // Ndeipi's own business banking (SRS-NDE-MEOW-001): "none", "simulated" or "meow". The Meow API key,
    // webhook secret and Anthropic key go in user-secrets or the environment, never here.
    "Banking": {
      "Provider": "none",
      "ApprovalThreshold": 10000,
      "RequiredApprovals": 1,
      "ApprovalLifetime": "3.00:00:00",
      "Meow": {
        "BaseUrl": "https://api.sandbox.meow.com/v1",
        "McpUrl": "https://mcp.meow.com/cli",
        "AllowCardReveal": false
      },
      "Assistant": {
        "Model": "claude-opus-5-5"
      }
    }
  }
}
