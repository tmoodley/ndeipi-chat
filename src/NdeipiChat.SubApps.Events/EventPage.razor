@* One event: live seats left per tier (FR-1.3), a 10-minute hold (FR-2.1), and checkout from the
   Ndeipi wallet. Tickets appear under My tickets once the payment is confirmed. *@
@implements IAsyncDisposable

@if (_event is null)
{
    <p class="@(_error is null ? "muted" : "error")">@(_error ?? "Loading…")</p>
}
else
{
    <h2>@_event.Title</h2>
    <p class="muted">@Format.When(_event.StartsAt) · @_event.Venue, @_event.City</p>
    <p class="muted small">@EventCategories.Label(_event.Category) · by @_event.Organizer.DisplayName@(_event.IsPublished ? "" : " · Draft, not on sale")</p>
    @if (_event.Description.Length > 0)
    {
        <p style="white-space: pre-line">@_event.Description</p>
    }

    @if (_event.CanManage || _event.CanScan)
    {
        <div class="ev-actions">
            @if (_event.CanManage)
            {
                <button class="secondary" @onclick="() => App.Go(new EventsView.Edit(Id))">Edit</button>
            }
            <button class="secondary" @onclick="() => App.Go(new EventsView.Gate(Id))">Scan tickets</button>
        </div>
    }

    @if (_hold is null)
    {
        <div class="card">
            <h3>Tickets</h3>
            @foreach (var tier in _event.Tiers)
            {
                <div class="ev-tier" @key="tier.Id">
                    <div class="ev-main">
                        <span class="name">@tier.Name</span>
                        <small>@Format.Price(tier.Price, _event.Currency) · @(tier.Available == 0 ? "sold out" : $"{tier.Available} left")</small>
                    </div>
                    @if (tier.Available > 0 && _event.IsPublished)
                    {
                        <select value="@Quantity(tier)" @onchange="e => _quantities[tier.Id] = int.Parse((string)e.Value!)" title="How many">
                            @for (var n = 1; n <= Math.Min(tier.Available, EventsContract.MaxTicketsPerHold); n++)
                            {
                                <option value="@n">@n</option>
                            }
                        </select>
                        <button class="primary" disabled="@_busy" @onclick="() => HoldAsync(tier)">Get</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="card ev-hold">
            <h3>@_hold.Quantity × @_hold.TierName</h3>
            @if (_order is null)
            {
                <p>
                    Held for you for <span class="ev-countdown">@Remaining</span>.
                    Total <strong>@Format.Price(_hold.Amount, _hold.Currency)</strong>@(IsFree ? "" : ", paid from your Ndeipi wallet to the organizer")
                </p>
                <div class="ev-actions">
                    <button class="primary" disabled="@(_busy || Expired)" @onclick="PayAsync">@(IsFree ? "Get tickets" : $"Pay {Format.Price(_hold.Amount, _hold.Currency)}")</button>
                    <button class="secondary" disabled="@_busy" @onclick="ReleaseAsync">Cancel</button>
                </div>
            }
            else if (_order.Status == OrderStatuses.Pending)
            {
                <p>Waiting for your wallet to confirm the payment… Your seats stay held until it does.</p>
            }
            else if (_order.Status == OrderStatuses.Paid)
            {
                <p>You're in. @(_order.Tickets.Count == 1 ? "Your ticket is" : $"Your {_order.Tickets.Count} tickets are") under My tickets.</p>
                <div class="ev-actions">
                    <button class="primary" @onclick="() => App.Go(new EventsView.Tickets())">My tickets</button>
                </div>
            }
            else
            {
                <p class="error">@(_order.Error ?? "The payment didn't go through.") The seats have gone back on sale.</p>
                <div class="ev-actions">
                    <button class="secondary" @onclick="Reset">Try again</button>
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
}

@code {
    [CascadingParameter] public EventsApp App { get; set; } = null!;
    [CascadingParameter] public SubAppContext Context { get; set; } = null!;
    [Parameter] public Guid Id { get; set; }

    EventDetailDto? _event;
    HoldDto? _hold;
    OrderDto? _order;
    string? _error;
    bool _busy;
    readonly Dictionary<Guid, int> _quantities = [];
    IAsyncDisposable? _live;
    PeriodicTimer? _timer;
    readonly CancellationTokenSource _lifetime = new();

    int Quantity(TicketTierDto tier) => _quantities.GetValueOrDefault(tier.Id, 1);
    bool IsFree => _hold?.Amount is "0";
    bool Expired => _hold is not null && _hold.ExpiresAt <= DateTimeOffset.UtcNow;
    string Remaining => _hold is null ? "" : (_hold.ExpiresAt - DateTimeOffset.UtcNow) is var left && left > TimeSpan.Zero ? left.ToString(@"m\:ss") : "0:00";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _event = await App.Api.GetAsync<EventDetailDto>($"{EventsApi.Base}/{Id}");
        }
        catch (EventsException ex)
        {
            _error = ex.Message;
            return;
        }

        // Seats left, live, as other people hold and buy (FR-1.3).
        if (Context.Realtime is { } realtime)
        {
            try
            {
                _live = await realtime.SubscribeAsync(EventsContract.Topic(Id), OnAvailabilityAsync);
            }
            catch (Exception)
            {
                // Not followable (a draft seen by a validator) or offline: the counts just won't move.
            }
        }
        _ = TickAsync();
    }

    Task OnAvailabilityAsync(System.Text.Json.JsonElement payload)
    {
        if (_event is null || ContractJson.Read<EventAvailabilityDto>(payload) is not { } update)
            return Task.CompletedTask;
        var left = update.Tiers.ToDictionary(t => t.TierId, t => t.Available);
        _event = _event with { Tiers = _event.Tiers.Select(t => left.TryGetValue(t.Id, out var n) ? t with { Available = n } : t).ToList() };
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Once a second: the hold's countdown, and a pending order's status every few.</summary>
    async Task TickAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticks = 0;
        try
        {
            while (await _timer.WaitForNextTickAsync(_lifetime.Token))
            {
                if (_order is { Status: OrderStatuses.Pending } pending && ++ticks % 3 == 0)
                {
                    try
                    {
                        _order = await App.Api.GetAsync<OrderDto>($"{EventsApi.Base}/orders/{pending.Id}");
                    }
                    catch (EventsException)
                    {
                    }
                }
                if (_hold is not null)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    Task HoldAsync(TicketTierDto tier) => RunAsync(async () =>
    {
        _hold = await App.Api.SendAsync<HoldDto>(HttpMethod.Post, $"{EventsApi.Base}/{Id}/holds", new HoldRequest(tier.Id, Quantity(tier)));
    });

    Task PayAsync() => RunAsync(async () =>
    {
        _order = await App.Api.SendAsync<OrderDto>(HttpMethod.Post, $"{EventsApi.Base}/holds/{_hold!.Id}/pay", new { });
    });

    Task ReleaseAsync() => RunAsync(async () =>
    {
        await App.Api.SendAsync(HttpMethod.Delete, $"{EventsApi.Base}/holds/{_hold!.Id}");
        _hold = null;
    });

    void Reset() => (_hold, _order, _error) = (null, null, null);

    async Task RunAsync(Func<Task> work)
    {
        (_busy, _error) = (true, null);
        try
        {
            await work();
        }
        catch (EventsException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        _timer?.Dispose();
        if (_live is not null)
            await _live.DisposeAsync();
    }
}
