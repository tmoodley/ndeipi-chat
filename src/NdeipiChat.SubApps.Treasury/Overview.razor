@implements IDisposable
@inject IJSRuntime JS

@* The treasury at a glance (FR-2): each account's available and current balance (cached ones at once,
   then fresh from the bank), the selected account's transactions, and its statement as CSV. *@

@if (_error is not null)
{
    <div class="tr-note warn">@_error</div>
}

@if (_accounts is null)
{
    <p class="muted">Loading balances…</p>
}
else if (_accounts.Count == 0)
{
    <section class="tr-card"><p class="muted" style="margin: 0">The bank reports no accounts yet.</p></section>
}
else
{
    <div class="tr-accounts">
        @foreach (var a in _accounts)
        {
            <div class="tr-account @(a.Type == "DIGITALWALLET" ? "wallet" : "") @(a.Id == App.SelectedAccountId ? "on" : "")" role="button" tabindex="0"
                 aria-pressed="@(a.Id == App.SelectedAccountId)" @key="a.Id" @onclick="() => SelectAsync(a.Id)" @onkeydown="e => KeyAsync(e, a.Id)">
                <span class="label"><span>@a.Name @(a.Last4 is null ? "" : $"••{a.Last4}")</span><span>@a.Status.ToLowerInvariant()</span></span>
                <span class="balance">@Format.Money(a.Available, a.Currency)</span>
                <span class="current">available · @Format.Money(a.Current, a.Currency) current</span>
            </div>
        }
    </div>
    <p class="muted small" style="margin: 0">
        @(_accounts.Any(a => a.Stale) ? "⚠️ The bank couldn't be reached; these balances are from " : "Updated ")@Format.When(_accounts.Min(a => a.RefreshedAt))
        @if (_refreshing)
        {
            <span> · refreshing…</span>
        }
    </p>

    @if (Selected is { } account)
    {
        <section class="tr-card">
            <div class="tr-row">
                <h3 class="grow">@account.Name transactions</h3>
                <button class="secondary" disabled="@_downloading" @onclick="StatementAsync">⬇ Statement (CSV)</button>
            </div>
            <div class="tr-two">
                <label class="tr-field">From<input type="date" @bind="_from" /></label>
                <label class="tr-field">To<input type="date" @bind="_to" /></label>
            </div>
            @if (_transactions is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (_transactions.Count == 0)
            {
                <p class="muted" style="margin: 0">No transactions yet.</p>
            }
            else
            {
                <div class="tr-list">
                    @foreach (var t in _transactions)
                    {
                        <div class="tr-row" @key="t.Id">
                            <span class="grow">
                                <b>@(t.Counterparty ?? t.Description)</b>
                                <small>@Format.When(t.At)@(t.Counterparty is null ? "" : $" · {t.Description}") · @t.Status.ToLowerInvariant()</small>
                            </span>
                            <span class="amount @(t.Direction == "credit" ? "in" : "")">@(t.Direction == "credit" ? "+" : "−")@Format.Money(t.Amount, t.Currency)</span>
                        </div>
                    }
                </div>
                @if (_cursor is not null)
                {
                    <button class="secondary" @onclick="MoreAsync">Show more</button>
                }
            }
        </section>
    }
}

@code {
    [CascadingParameter] public TreasuryApp App { get; set; } = null!;

    IReadOnlyList<TreasuryAccountDto>? _accounts;
    List<TreasuryTransactionDto>? _transactions;
    string? _cursor, _error;
    bool _refreshing, _downloading;
    DateTime _from = DateTime.Today.AddDays(-30), _to = DateTime.Today;

    TreasuryAccountDto? Selected => _accounts?.FirstOrDefault(a => a.Id == App.SelectedAccountId);

    protected override async Task OnInitializedAsync()
    {
        App.Changed += OnChanged;
        // What was seen last, at once (NFR-PERF-03); then the server's cache, then the bank.
        _accounts = App.CachedAccounts;
        await LoadAsync(refresh: false);
        _ = InvokeAsync(async () =>
        {
            await LoadAsync(refresh: true);
            StateHasChanged();
        });
    }

    void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync(refresh: false);
        await LoadTransactionsAsync();
        StateHasChanged();
    });

    async Task LoadAsync(bool refresh)
    {
        _refreshing = refresh;
        try
        {
            _accounts = (await App.Api.GetAsync<TreasuryList<TreasuryAccountDto>>($"accounts{(refresh ? "?refresh=true" : "")}")).Data;
            App.CachedAccounts = _accounts;
            _error = null;
            if (Selected is null && _accounts.Count > 0)
            {
                App.SelectedAccountId = _accounts[0].Id;
                await LoadTransactionsAsync();
            }
            else if (_transactions is null && Selected is not null)
                await LoadTransactionsAsync();
        }
        catch (TreasuryException e)
        {
            _error = e.Message;
            _accounts ??= [];
        }
        finally
        {
            _refreshing = false;
        }
    }

    async Task SelectAsync(string id)
    {
        App.SelectedAccountId = id;
        _transactions = null;
        await LoadTransactionsAsync();
    }

    Task KeyAsync(KeyboardEventArgs e, string id) => e.Key is "Enter" or " " ? SelectAsync(id) : Task.CompletedTask;

    async Task LoadTransactionsAsync()
    {
        if (App.SelectedAccountId is not { } id)
            return;
        try
        {
            var page = await App.Api.GetAsync<TreasuryTransactionPageDto>($"accounts/{Uri.EscapeDataString(id)}/transactions?limit=25");
            (_transactions, _cursor) = (page.Data.ToList(), page.NextCursor);
        }
        catch (TreasuryException e)
        {
            (_transactions, _error) = ([], e.Message);
        }
    }

    async Task MoreAsync()
    {
        try
        {
            var page = await App.Api.GetAsync<TreasuryTransactionPageDto>(
                $"accounts/{Uri.EscapeDataString(App.SelectedAccountId!)}/transactions?limit=25&cursor={Uri.EscapeDataString(_cursor!)}");
            _transactions!.AddRange(page.Data);
            _cursor = page.NextCursor;
        }
        catch (TreasuryException e)
        {
            _error = e.Message;
        }
    }

    async Task StatementAsync()
    {
        _downloading = true;
        try
        {
            var from = new DateTimeOffset(_from.Date, TimeZoneInfo.Local.GetUtcOffset(_from)).ToString("O");
            var to = new DateTimeOffset(_to.Date.AddDays(1).AddTicks(-1), TimeZoneInfo.Local.GetUtcOffset(_to)).ToString("O");
            var bytes = await App.Api.DownloadAsync(
                $"accounts/{Uri.EscapeDataString(App.SelectedAccountId!)}/statement.csv?from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}");
            await JS.InvokeVoidAsync("ndeipi.saveFile", bytes, $"{Selected!.Name}-{_from:yyyy-MM-dd}-to-{_to:yyyy-MM-dd}.csv", "text/csv");
        }
        catch (TreasuryException e)
        {
            _error = e.Message;
        }
        finally
        {
            _downloading = false;
        }
    }

    public void Dispose() => App.Changed -= OnChanged;
}
