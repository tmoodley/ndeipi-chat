<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- index.html names blazor.webassembly.js plainly: the API serves it with MapFallbackToFile,
         which doesn't fill fingerprint placeholders. MapStaticAssets maps the plain name. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <!-- Client.Core's SQLite capture queue brings native SQLite, which can't run in the browser.
         The web app queues captures in IndexedDB instead (Platform/IndexedDbCaptureQueue.cs). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NdeipiChat.Client.Core\NdeipiChat.Client.Core.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Sdk\NdeipiChat.SubApps.Sdk.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Inventory\NdeipiChat.SubApps.Inventory.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Events\NdeipiChat.SubApps.Events.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Gigs\NdeipiChat.SubApps.Gigs.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Pos\NdeipiChat.SubApps.Pos.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Donations\NdeipiChat.SubApps.Donations.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Finance\NdeipiChat.SubApps.Finance.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Market\NdeipiChat.SubApps.Market.csproj" />
    <ProjectReference Include="..\NdeipiChat.SubApps.Creators\NdeipiChat.SubApps.Creators.csproj" />
  </ItemGroup>

  <!-- Sub-apps (SRS SR-02): published with the site but not downloaded until first opened. The
       shell checks each against the manifest's SHA-256, then loads it (Pages/SubAppHost.razor).
       Their root components are only found by reflection, so they're kept whole when trimming. -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Inventory.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Inventory" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Events.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Events" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Gigs.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Gigs" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Pos.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Pos" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Donations.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Donations" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Finance.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Finance" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Market.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Market" />
    <BlazorWebAssemblyLazyLoad Include="NdeipiChat.SubApps.Creators.wasm" />
    <TrimmerRootAssembly Include="NdeipiChat.SubApps.Creators" />
  </ItemGroup>

</Project>
