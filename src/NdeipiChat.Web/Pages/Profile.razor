@page "/u/{Id:guid}"
@inject ChatApi Api
@inject SocialActions Social
@inject IServiceProvider Services
@inject NavigationManager Navigation

@* A person's profile: who they are, what they post, their groups and photos, and ways to connect
   across the apps: follow, message, pay, add as a Shamwari, hire. *@

<PageTitle>@(_profile?.User.DisplayName ?? "Profile") · Ndeipi</PageTitle>

<div class="sc-page">
    @if (_profile is null)
    {
        <p class="@(_error is null ? "muted" : "error")">@(_error ?? "Loading…")</p>
    }
    else
    {
        var p = _profile;
        <ProfileHero Profile="p" StatClicked="OnStat">
            <Actions>
                @if (p.IsMe)
                {
                    <button class="btn-a" @onclick='() => Edit("info")'>Edit profile</button>
                    <a class="button btn-b" href="feed/new">New post</a>
                }
                else
                {
                    <button class="@(p.IFollow ? "secondary" : "btn-a")" disabled="@_busy" @onclick="ToggleFollowAsync">@(p.IFollow ? "Following ✓" : "Follow +")</button>
                    @if (Social.CanChat)
                    {
                        <button class="btn-b" disabled="@_busy" @onclick="() => Social.MessageAsync(p.User.Id)">Send message</button>
                    }
                }
            </Actions>
        </ProfileHero>

        @if (!p.IsMe)
        {
            <div class="quick-row">
                @if (Social.CanChat && Social.CanPay)
                {
                    <button class="quick green" @onclick='() => Social.MessageAsync(p.User.Id, "send-money")'><span class="ring">$</span>Send money</button>
                }
                @if (Social.CanChat)
                {
                    <button class="quick blue" @onclick='() => Social.MessageAsync(p.User.Id, "transfer")'><span class="ring">🪙</span>Send tokens</button>
                }
                @if (p.Gig is not null && Social.CanHire)
                {
                    <button class="quick brown" @onclick="() => Social.Hire(p.User.Id)"><span class="ring">🧰</span>Hire</button>
                }
                @if (!p.IsShamwari)
                {
                    <button class="quick purple" disabled="@_busy" @onclick="AddShamwariAsync"><span class="ring">🤝</span>@(_shamwariAsked ? "Asked ✓" : "Add Shamwari")</button>
                }
            </div>
        }

        <nav class="sc-tabs glass">
            <button class="sc-tab @On("timeline")" @onclick='() => _tab = "timeline"'><span class="ico">📰</span>Timeline</button>
            <button class="sc-tab @On("about")" @onclick='() => _tab = "about"'><span class="ico">🙂</span>About</button>
            <button class="sc-tab @On("groups")" @onclick='() => _tab = "groups"'><span class="ico">👥</span>Groups</button>
            <button class="sc-tab @On("photos")" @onclick='() => _tab = "photos"'><span class="ico">🖼️</span>Photos</button>
            <button class="sc-tab @On("followers")" @onclick='() => ShowPeopleAsync("followers")'><span class="ico">⭐</span>Followers</button>
            <button class="sc-tab @On("following")" @onclick='() => ShowPeopleAsync("following")'><span class="ico">➡️</span>Following</button>
        </nav>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        @switch (_tab)
        {
            case "timeline":
                <div class="sc-grid">
                    <div class="sc-col side">
                        <AboutWidget Profile="p" />
                        @if (p.Gig is { } gig)
                        {
                            <section class="widget glass">
                                <div class="widget-head"><h3>Work</h3>@if (!p.IsMe && Social.CanHire) {<button @onclick="() => Social.Hire(p.User.Id)">Hire</button>}</div>
                                <p style="margin: 0; font-weight: 600">@gig.Headline</p>
                                <div class="chips">
                                    @foreach (var skill in gig.Skills)
                                    {
                                        <span class="chip-tag">@GigSkills.Label(skill)</span>
                                    }
                                </div>
                                <p class="muted small" style="margin: 0">@(gig.Rating is { } r ? $"★ {r:0.0} from {gig.RatingCount}" : "No ratings yet") · @gig.CompletedGigs gigs done@(gig.IsAvailable ? " · available now" : "")</p>
                            </section>
                        }
                    </div>
                    <div class="sc-col">
                        <SocialFeed Feed="_feed" CanPost="p.IsMe" Empty="@(p.IsMe ? "Nothing posted yet." : $"{p.User.DisplayName} hasn't posted yet.")" />
                    </div>
                    <div class="sc-col side">
                        <section class="widget glass">
                            <div class="widget-head"><h3>Photos<em>@p.Photos.Count</em></h3><button @onclick='() => _tab = "photos"'>See all</button></div>
                            @if (p.Photos.Count == 0)
                            {
                                <p class="muted small" style="margin: 0">No photos yet.</p>
                            }
                            <div class="photo-grid">
                                @foreach (var photo in p.Photos.Take(11))
                                {
                                    <img src="@photo.Url" alt="" loading="lazy" @key="photo.Id" />
                                }
                                @if (p.Photos.Count > 11)
                                {
                                    <button class="more" @onclick='() => _tab = "photos"'>+@(p.Photos.Count - 11)</button>
                                }
                            </div>
                        </section>
                        <section class="widget glass">
                            <div class="widget-head"><h3>Groups<em>@p.Groups.Count</em></h3></div>
                            @foreach (var g in p.Groups.Take(6))
                            {
                                <a class="mini-row" href="groups/@g.Id" @key="g.Id">
                                    <HexAvatar Url="@g.AvatarUrl" Icon="@g.Icon" Tone="@("tone-" + g.Tone)" Size="44" Class="icon-hex" />
                                    <span class="grow"><strong>@g.Name</strong><small>@g.MemberCount members</small></span>
                                </a>
                            }
                        </section>
                    </div>
                </div>
                break;

            case "about":
                var d = p.Details ?? ProfileDetailsDto.Empty;
                <div class="sc-grid">
                    <div class="sc-col side">
                        <AboutWidget Profile="p" Edit='() => Edit("info")' />
                        @if (!p.IsMe)
                        {
                            <section class="widget glass">
                                <div class="widget-head"><h3>Connections</h3></div>
                                <dl class="facts">
                                    <dt>Shamwari</dt><dd>@(p.IsShamwari ? "Yes, you can chat and send money" : "Not yet")</dd>
                                    <dt>Follows you</dt><dd>@(p.FollowsMe ? "Yes" : "No")</dd>
                                    <dt>You follow</dt><dd>@(p.IFollow ? "Yes" : "No")</dd>
                                </dl>
                            </section>
                        }
                    </div>

                    <div class="sc-col">
                        <section class="widget glass">
                            <div class="widget-head"><h3>Interests</h3>@if (p.IsMe) {<button @onclick='() => Edit("interests")'>Edit</button>}</div>
                            @if (d.Interests.Count == 0)
                            {
                                <p class="muted small" style="margin: 0">@(p.IsMe ? "Add what you're into: music, sport, books, food." : "Nothing here yet.")</p>
                            }
                            <div class="fl-row">
                                @foreach (var interest in d.Interests)
                                {
                                    <div class="interest"><h4>@interest.Title</h4><p>@interest.Text</p></div>
                                }
                            </div>
                        </section>
                        <section class="widget glass">
                            <div class="widget-head"><h3>Jobs and education</h3>@if (p.IsMe) {<button @onclick='() => Edit("work")'>Edit</button>}</div>
                            @if (d.Jobs.Count + d.Education.Count == 0)
                            {
                                <p class="muted small" style="margin: 0">@(p.IsMe ? "Add where you've worked and studied." : "Nothing here yet.")</p>
                            }
                            <div class="fl-row">
                                @foreach (var (title, list) in new[] { ("Jobs", d.Jobs), ("Education", d.Education) })
                                {
                                    if (list.Count == 0)
                                        continue;
                                    <div>
                                        <h4 style="margin: 0 0 12px">@title</h4>
                                        <div class="timeline">
                                            @foreach (var e in list)
                                            {
                                                <div class="entry">
                                                    @if (e.Period is { } when) {<span class="when">@when</span>}
                                                    <strong>@e.Title</strong>
                                                    @if (e.Place is { } place) {<span class="muted small">@place</span>}
                                                    @if (e.Description is { } text) {<p>@text</p>}
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    </div>

                    <div class="sc-col side">
                        @if (p.IsMe)
                        {
                            <section class="widget glass">
                                <div class="widget-head"><h3>Profile completion</h3></div>
                                <div class="completion-ring" style="--pct: @p.Completion" data-label="@($"{p.Completion}%")"></div>
                                <p class="muted small" style="margin: 0; text-align: center">@(p.Completion == 100 ? "All done. Nice!" : "Fill in your profile so people know who they're talking to.")</p>
                                @if (p.Completion < 100)
                                {
                                    <button class="btn-a wide" @onclick='() => Edit("info")'>Complete my profile</button>
                                }
                            </section>
                        }
                        <section class="widget glass">
                            <div class="widget-head"><h3>Skills<em>@d.Skills.Count</em></h3>@if (p.IsMe) {<button @onclick='() => Edit("skills")'>Edit</button>}</div>
                            @if (d.Skills.Count == 0)
                            {
                                <p class="muted small" style="margin: 0">@(p.IsMe ? "What are you good at?" : "None listed.")</p>
                            }
                            <div class="chips">
                                @foreach (var skill in d.Skills)
                                {
                                    <span class="chip-tag">@skill</span>
                                }
                            </div>
                        </section>
                    </div>
                </div>
                break;

            case "groups":
                <div class="card-grid">
                    @foreach (var g in p.Groups)
                    {
                        <GroupCard @key="g.Id" Group="g" Join="JoinAsync" />
                    }
                </div>
                @if (p.Groups.Count == 0)
                {
                    <div class="empty"><p>No groups yet.</p></div>
                }
                break;

            case "photos":
                <div class="sc-section-head"><div><div class="kicker">Browse @p.User.DisplayName.Split(' ')[0]'s</div><div class="big">Latest photos<em>@p.Photos.Count</em></div></div></div>
                <div class="album-grid">
                    @foreach (var photo in p.Photos)
                    {
                        <a class="album" @key="photo.Id" href="@photo.Url.Replace("/thumb", "/full")" target="_blank" rel="noopener">
                            <span class="art" style="background: url('@photo.Url') center / cover"></span>
                        </a>
                    }
                </div>
                @if (p.Photos.Count == 0)
                {
                    <div class="empty"><p>No photos yet.</p></div>
                }
                break;

            default:
                <div class="card-grid">
                    @foreach (var person in _people)
                    {
                        <PersonCard @key="person.User.Id" Person="person" />
                    }
                </div>
                @if (_people.Count == 0)
                {
                    <div class="empty"><p>Nobody yet.</p></div>
                }
                break;
        }

        @if (_editing is { } section)
        {
            <ProfileEditor Profile="p" Section="@section" Saved="OnSaved" Closed="() => _editing = null" />
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    /// <summary>Opens the editor on arrival, on this section ("1" for the first).</summary>
    [SupplyParameterFromQuery(Name = "edit")] public string? EditSection { get; set; }

    SocialProfileDto? _profile;
    FeedViewModel _feed = null!;
    List<PersonCardDto> _people = [];
    string _tab = "timeline";
    string? _error, _editing;
    bool _busy, _shamwariAsked;

    string On(string tab) => _tab == tab ? "on" : "";

    protected override async Task OnParametersSetAsync()
    {
        _feed = ActivatorUtilities.CreateInstance<FeedViewModel>(Services);
        _feed.AuthorId = Id;
        _tab = Tab ?? "timeline";
        _profile = null;
        await Run(async () => _profile = await Api.GetJsonAsync<SocialProfileDto>($"{SocialActions.Base}/profiles/{Id}"));
        if (_profile is { IsMe: true } && EditSection is { } section)
            Edit(section is "info" or "images" or "interests" or "work" or "skills" or "links" ? section : "info");
        await _feed.RefreshCommand.ExecuteAsync(null);
        if (_tab is "followers" or "following")
            await ShowPeopleAsync(_tab);
    }

    async Task OnStat(string stat)
    {
        if (stat is "followers" or "following")
            await ShowPeopleAsync(stat);
        else
            _tab = stat;
    }

    async Task ShowPeopleAsync(string which)
    {
        _tab = which;
        await Run(async () => _people = await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/profiles/{Id}/{which}"));
    }

    async Task ToggleFollowAsync() => await Run(async () =>
    {
        var follow = !_profile!.IFollow;
        await Social.FollowAsync(Id, follow);
        _profile = _profile with { IFollow = follow, FollowerCount = _profile.FollowerCount + (follow ? 1 : -1) };
    });

    async Task AddShamwariAsync() => await Run(async () =>
    {
        await Social.AddShamwariAsync(Id);
        _shamwariAsked = true;
    });

    void Edit(string section) => _editing = section;

    void OnSaved(SocialProfileDto saved) => _profile = saved;

    async Task JoinAsync(GroupSummaryDto group) => await Run(async () =>
    {
        await Api.SendJsonAsync<GroupDetailDto>(HttpMethod.Post, $"{SocialActions.Base}/groups/{group.Id}/join");
        Navigation.NavigateTo($"groups/{group.Id}");
    });

    async Task Run(Func<Task> work)
    {
        (_busy, _error) = (true, null);
        try
        {
            await work();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
