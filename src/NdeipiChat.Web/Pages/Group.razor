@page "/groups/{Id:guid}"
@inject ChatApi Api
@inject IServiceProvider Services

@* A group: its banner and stats, the timeline members post to, its info and rules, and its members. *@

<PageTitle>@(_group?.Group.Name ?? "Group") · Ndeipi</PageTitle>

<div class="sc-page">
    @if (_group is null)
    {
        <p class="@(_error is null ? "muted" : "error")">@(_error ?? "Loading…")</p>
    }
    else
    {
        var g = _group.Group;
        var canSee = !g.IsPrivate || g.IsMember;
        <section class="sc-hero glass">
            <div class="sc-cover tone-@g.Tone @(g.CoverUrl is null ? "" : "has-image")">
                @if (g.CoverUrl is { } cover)
                {
                    <img class="cover-img" src="@cover" alt="" onload="this.classList.add('ready')" />
                }
            </div>
            <div class="sc-hero-body">
                <div class="sc-stats">
                    <button class="sc-stat" @onclick='() => _tab = "members"'><b>@g.MemberCount</b><span>Members</span></button>
                    <button class="sc-stat" @onclick='() => _tab = "timeline"'><b>@g.PostCount</b><span>Posts</span></button>
                    <div class="sc-stat"><b>@(g.IsPrivate ? "🔒" : "🌍")</b><span>@(g.IsPrivate ? "Private" : "Public")</span></div>
                </div>
                <div class="sc-center">
                    <HexAvatar Url="@g.AvatarUrl" Icon="@g.Icon" Tone="@("tone-" + g.Tone)" Size="128" Class="icon-hex" />
                    <div class="sc-identity">
                        <div class="name">@g.Name</div>
                        <div class="sub">@(g.Tagline ?? $"Started by {_group.Owner.DisplayName}")</div>
                    </div>
                </div>
                <div class="sc-actions">
                    @if (g.MyRole == GroupRoles.Owner)
                    {
                        <button class="btn-a" @onclick='() => Manage("info")'>Manage group</button>
                    }
                    else if (g.IsMember)
                    {
                        <button class="secondary" disabled="@_busy" @onclick="LeaveAsync">Leave group</button>
                    }
                    else if (!g.IsPrivate)
                    {
                        <button class="btn-a" disabled="@_busy" @onclick="JoinAsync">Join group +</button>
                    }
                    else
                    {
                        <button class="secondary" disabled>Invite only</button>
                    }
                </div>
            </div>
        </section>

        <nav class="sc-tabs glass">
            <button class="sc-tab @On("timeline")" @onclick='() => _tab = "timeline"'><span class="ico">📰</span>Timeline</button>
            <button class="sc-tab @On("info")" @onclick='() => _tab = "info"'><span class="ico">ℹ️</span>Info</button>
            <button class="sc-tab @On("members")" @onclick="ShowMembersAsync"><span class="ico">👥</span>Members</button>
        </nav>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        @switch (_tab)
        {
            case "timeline":
                <div class="sc-grid two">
                    <div class="sc-col side">
                        <InfoWidget Group="_group" />
                    </div>
                    <div class="sc-col">
                        @if (canSee)
                        {
                            <SocialFeed Feed="_feed" GroupId="g.Id" CanPost="g.IsMember" Placeholder="@($"Share something with {g.Name}")"
                                        Empty="@(g.IsMember ? "No posts yet. Start the conversation!" : "No posts yet. Join to post.")" />
                        }
                        else
                        {
                            <div class="widget glass empty"><p>🔒 This group is private. Its owner adds members.</p></div>
                        }
                    </div>
                </div>
                break;

            case "info":
                <div class="sc-grid two">
                    <div class="sc-col"><InfoWidget Group="_group" /></div>
                    <div class="sc-col">
                        <section class="widget glass">
                            <div class="widget-head"><h3>Group rules</h3></div>
                            @if (Rules.Count == 0)
                            {
                                <p class="muted" style="margin: 0">@(canSee ? "No rules set. Be kind." : "Members can see the rules.")</p>
                            }
                            @for (var i = 0; i < Rules.Count; i++)
                            {
                                <p style="margin: 0"><strong>@((i + 1).ToString("00"))-</strong> @Rules[i]</p>
                            }
                        </section>
                        @if (g.MyRole == GroupRoles.Owner)
                        {
                            <section class="widget glass">
                                <div class="widget-head"><h3>Organizer tools</h3></div>
                                <div class="actions-row" style="display: flex; flex-wrap: wrap; gap: 8px">
                                    <button class="btn-a" @onclick='() => Manage("info")'>Edit info</button>
                                    <button class="secondary" @onclick='() => Manage("images")'>Avatar and cover</button>
                                    <button class="secondary" @onclick='() => Manage("members")'>Members</button>
                                </div>
                            </section>
                        }
                    </div>
                </div>
                break;

            case "members":
                <div class="sc-section-head"><div><div class="kicker">Browse group</div><div class="big">Members<em>@g.MemberCount</em></div></div></div>
                <div class="card-grid">
                    @foreach (var person in _members)
                    {
                        <PersonCard @key="person.User.Id" Person="person" />
                    }
                </div>
                @if (_members.Count == 0)
                {
                    <div class="empty"><p>@(canSee ? "No members to show." : "Members of private groups are only shown to members.")</p></div>
                }
                break;
        }

        @if (_managing is { } section)
        {
            <GroupEditor Group="_group" Section="@section" Saved="Show" Closed="() => _managing = null" />
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    GroupDetailDto? _group;
    FeedViewModel _feed = null!;
    List<PersonCardDto> _members = [];
    string _tab = "timeline";
    string? _error, _managing;
    bool _busy;

    string On(string tab) => _tab == tab ? "on" : "";

    List<string> Rules => (_group?.Rules ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    protected override async Task OnParametersSetAsync()
    {
        _feed = ActivatorUtilities.CreateInstance<FeedViewModel>(Services);
        _feed.GroupId = Id;
        _group = null;
        await Run(async () => Show(await Api.GetJsonAsync<GroupDetailDto>($"{SocialActions.Base}/groups/{Id}")));
        if (_group is { Group: { IsPrivate: false } or { IsMember: true } })
            await _feed.RefreshCommand.ExecuteAsync(null);
    }

    void Show(GroupDetailDto group) => _group = group;

    void Manage(string section) => _managing = section;

    async Task ShowMembersAsync()
    {
        _tab = "members";
        await Run(async () => _members = await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/groups/{Id}/members"));
    }

    async Task JoinAsync()
    {
        await Run(async () => Show(await Api.SendJsonAsync<GroupDetailDto>(HttpMethod.Post, $"{SocialActions.Base}/groups/{Id}/join")));
        await _feed.RefreshCommand.ExecuteAsync(null);
    }

    Task LeaveAsync() => Run(async () => Show(await Api.SendJsonAsync<GroupDetailDto>(HttpMethod.Post, $"{SocialActions.Base}/groups/{Id}/leave")));

    async Task Run(Func<Task> work)
    {
        (_busy, _error) = (true, null);
        try
        {
            await work();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
