@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@page "/pay"
@page "/pay/{Code}"
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClients
@inject NavigationManager Navigation
@inject WebEmbedding Embedding
@inject IJSRuntime JS

@* Ndeipi Pay, the customer's side (PosPay): scan a shop's QR code (or open its link), see who's
   asking for how much, and pay from your wallet. The shop's till completes the sale when the
   money arrives, and the receipt comes to your chats. *@

<PageTitle>@(Code is null ? "Scan to pay" : "Pay") · Ndeipi</PageTitle>

<header class="bar">
    <button class="bar-back link" title="Back" @onclick="Back">‹</button>
    <h1>@(Code is null ? "Scan to pay" : "Ndeipi Pay")</h1>
</header>

<div class="page pay-page">
    @if (Code is null)
    {
        <section class="pay-card glass">
            @if (_cameraFailed)
            {
                <p class="muted">The camera isn't available here. Type or paste the code from the shop's screen instead.</p>
            }
            else
            {
                <video class="pay-video" @ref="_video" muted></video>
                <p class="muted">Point the camera at the QR code on the shop's screen.</p>
            }
            <form class="pay-manual" @onsubmit="SubmitTypedAsync">
                <input @bind="_typed" placeholder="Or paste the code or link" autocomplete="off" spellcheck="false" />
                <button type="submit" class="secondary">Open</button>
            </form>
            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }
        </section>
    }
    else if (_request is null)
    {
        <div class="empty"><p>@(_error ?? "Loading…")</p></div>
    }
    else
    {
        var r = _request;
        <section class="pay-card glass">
            <div class="pay-shop">
                <span class="pay-icon">🛒</span>
                <div>
                    <strong>@r.MerchantName</strong>
                    <small>@r.StoreName</small>
                </div>
            </div>
            <div class="pay-amount">@Amount(r)</div>

            @if (r.Status == PosQrStatuses.Waiting)
            {
                <button class="primary wide" disabled="@_busy" @onclick="PayAsync">@(_busy ? "Paying…" : $"Pay {Amount(r)}")</button>
                <p class="muted small">From your Ndeipi wallet to @r.MerchantName. It can't be reversed once confirmed.</p>
            }
            else if (!r.IsMine)
            {
                <p class="pay-state">@(r.Status == PosQrStatuses.Expired ? "This code has expired. Ask the shop to show a new one." : "This code has already been used.")</p>
            }
            else if (r.Status == PosQrStatuses.Paying)
            {
                <div class="pay-badge">⏳</div>
                <p class="pay-state">Paying… The shop sees it the moment the money arrives.</p>
            }
            else if (r.Status == PosQrStatuses.Paid)
            {
                <div class="pay-badge ok">✓</div>
                <p class="pay-state"><strong>Paid.</strong> Your receipt will arrive in your chats.</p>
                <button class="secondary wide" @onclick="@(() => Navigation.NavigateTo("chats"))">Open chats</button>
            }
            else
            {
                <div class="pay-badge bad">✕</div>
                <p class="pay-state">@(r.Error ?? "The payment didn't go through.") Nothing was taken from your wallet.</p>
            }

            @if (_error is not null)
            {
                <p class="error">@_error</p>
                @if (_error.Contains("Wallet"))
                {
                    <button class="link" @onclick="@(() => Navigation.NavigateTo("wallet"))">Go to Wallet</button>
                }
            }
        </section>
    }
</div>

@code {
    [Parameter] public string? Code { get; set; }

    PayRequestDto? _request;
    string? _error, _typed;
    bool _busy, _cameraFailed, _scanning;
    ElementReference _video;
    IJSObjectReference? _scanner;
    DotNetObjectReference<Pay>? _self;
    CancellationTokenSource? _watching;

    HttpClient Api => HttpClients.CreateClient(ChatApi.HttpClientName);

    static string Amount(PayRequestDto r) => $"{r.Amount.ToString("N2", CultureInfo.InvariantCulture)} {r.Currency.ToUpperInvariant()}";

    protected override async Task OnParametersSetAsync()
    {
        (_request, _error) = (null, null);
        _watching?.Cancel();
        if (Code is null)
            return;
        await StopScannerAsync();
        await LoadAsync();
        if (_request is { IsMine: true } r && !PosQrStatuses.IsFinal(r.Status))
            Watch();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Code is null && !_scanning && !_cameraFailed)
        {
            _scanning = true;
            try
            {
                _self ??= DotNetObjectReference.Create(this);
                _scanner ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/qr-scan.js");
                _cameraFailed = !await _scanner.InvokeAsync<bool>("start", _video, _self);
            }
            catch (JSException)
            {
                _cameraFailed = true;
            }
            if (_cameraFailed)
                StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnScanned(string text) => InvokeAsync(() => Open(text));

    Task SubmitTypedAsync()
    {
        Open(_typed);
        return Task.CompletedTask;
    }

    void Open(string? text)
    {
        if (PosPay.CodeFrom(text) is { } code)
        {
            _typed = null;
            Navigation.NavigateTo($"{PosPay.PayPath}/{code}");
        }
        else
        {
            _error = "That isn't a Ndeipi Pay code.";
            StateHasChanged();
        }
    }

    async Task LoadAsync()
    {
        try
        {
            using var response = await Api.GetAsync($"{PosPay.BasePath}/{Uri.EscapeDataString(Code!)}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                _error = "There's no payment with this code. Check it with the shop.";
            else if (!response.IsSuccessStatusCode)
                _error = await ProblemAsync(response);
            else
                _request = await response.Content.ReadFromJsonAsync<PayRequestDto>(ContractJson.Options);
        }
        catch (HttpRequestException)
        {
            _error = "No connection. Check it and try again.";
        }
    }

    async Task PayAsync()
    {
        (_busy, _error) = (true, null);
        try
        {
            using var response = await Api.PostAsync($"{PosPay.BasePath}/{Uri.EscapeDataString(Code!)}", null);
            if (!response.IsSuccessStatusCode)
                _error = await ProblemAsync(response);
            else
            {
                _request = await response.Content.ReadFromJsonAsync<PayRequestDto>(ContractJson.Options);
                if (_request is { } r && !PosQrStatuses.IsFinal(r.Status))
                    Watch();
            }
        }
        catch (HttpRequestException)
        {
            _error = "No connection. Nothing was paid; try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Checks every two seconds until the payment has gone through or failed.</summary>
    void Watch()
    {
        _watching?.Cancel();
        var watching = _watching = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            while (!watching.IsCancellationRequested)
            {
                await Task.Delay(2000);
                if (watching.IsCancellationRequested)
                    return;
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
                if (_request is { } r && PosQrStatuses.IsFinal(r.Status))
                    return;
            }
        });
    }

    static async Task<string> ProblemAsync(HttpResponseMessage response)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
            if (problem.TryGetProperty("title", out var title) && title.GetString() is { Length: > 0 } text)
                return text;
        }
        catch (JsonException)
        {
        }
        return "Something went wrong. Please try again.";
    }

    void Back()
    {
        if (Embedding.IsEmbedded)
            Embedding.Leave();
        else
            Navigation.NavigateTo("wallet");
    }

    async Task StopScannerAsync()
    {
        if (_scanner is null)
            return;
        try
        {
            await _scanner.InvokeVoidAsync("stop", _video);
        }
        catch (JSException)
        {
        }
        _scanning = false;
    }

    public async ValueTask DisposeAsync()
    {
        _watching?.Cancel();
        await StopScannerAsync();
        if (_scanner is not null)
        {
            try
            {
                await _scanner.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _self?.Dispose();
    }
}
