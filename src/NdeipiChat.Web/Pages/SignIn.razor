@page "/signin"
@inject WebSignIn Flow
@inject WebEmbedding Embedding
@inject NavigationManager Navigation

<PageTitle>Sign in · Ndeipi Chat</PageTitle>

<div class="signin">
    <div class="logo large">N</div>
    <h1>Ndeipi Chat</h1>
    <p class="muted">Chat with your Shamwaris and send them money.</p>
    <button class="primary wide" disabled="@_busy" @onclick="StartAsync">@(_busy ? "Opening sign-in…" : "Sign in")</button>
</div>

@code {
    bool _busy;

    /// <summary>In the phone app's WebView the app signs it in; Clerk's page would only open the browser.</summary>
    protected override void OnInitialized()
    {
        if (Embedding.IsInApp)
            WebEmbedding.RequestSignIn(Navigation);
    }

    async Task StartAsync()
    {
        _busy = true;
        await Flow.StartAsync();
    }
}
