@page "/chat/{Id:guid}"
@inherits ViewModelPage<ChatViewModel>
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ChatSession Session
@inject LauncherViewModel Launcher
@inject ChatApi Api
@inject ChatsViewModel Chats

@* The messenger: your chats, this conversation, and the exchange panel for sending money and
   tokens here. On a phone, one pane at a time; the exchange panel slides over the conversation. *@

<PageTitle>@(string.IsNullOrEmpty(Vm.Title) ? "Chat" : Vm.Title) · Ndeipi</PageTitle>

<div class="messenger in-chat">
    <ChatList ActiveId="Id" />

    <section class="conversation">
        <header class="conversation-head glass">
            <a class="icon-button button back" href="chats" title="Back">‹</a>
            @if (Other is { } other && Launcher.Allows(BuiltInApps.Feed))
            {
                <a href="u/@other.Id" title="@other.DisplayName's profile">
                    <Avatar Url="@Vm.Conversation?.AvatarUrl" Initials="@Display.Initials(Vm.Title)" Size="46" />
                </a>
            }
            else
            {
                <Avatar Url="@Vm.Conversation?.AvatarUrl" Initials="@Display.Initials(Vm.Title)" Size="46" />
            }
            <div class="who">
                <strong>@Vm.Title @if (Other is { } person) {<TrustBadge UserId="person.Id" />}</strong>
                @if (Vm.TypingText is not null)
                {
                    <span class="typing" style="padding: 0">@Vm.TypingText</span>
                }
                else
                {
                    <span class="pill">@(Vm.Conversation?.Type == ConversationType.Group ? $"Group · {Vm.Conversation.Members.Count}" : "Direct")</span>
                }
            </div>
            <button class="icon-button brand" title="Send money or tokens" @onclick='() => OpenPanel(_tab == "history" ? DefaultTab : _tab)'>💸</button>
            <button class="icon-button" title="Transfers in this chat" @onclick='() => OpenPanel("history")'>🧾</button>
        </header>

        <div class="messages" @ref="_scroller">
            @if (Vm.HasMore)
            {
                <button class="link center" disabled="@Vm.IsLoading" @onclick="() => Vm.LoadOlderCommand.ExecuteAsync(null)">Earlier messages</button>
            }
            @foreach (var message in Vm.Messages)
            {
                <MessageBubble @key="message.ClientMessageId" Message="message" Retry="m => Vm.RetryCommand.ExecuteAsync(m)" Forward="StartForward" />
            }
        </div>

        @if (Vm.IsExtensionPanelOpen)
        {
            <div class="actions">
                @foreach (var action in Vm.Actions)
                {
                    <button class="action" @onclick="() => RunAsync(action)">
                        <span class="glyph">@action.Glyph</span>
                        <span>@action.Title</span>
                    </button>
                }
            </div>
        }

        @if (_upload is not null)
        {
            <div class="upload-status @(_uploadFailed ? "failed" : "")">@_upload</div>
        }

        <form class="composer" @onsubmit="() => Vm.SendTextCommand.ExecuteAsync(null)">
            <button type="button" class="round" title="Send money, tokens and more" @onclick="() => Vm.ToggleExtensionPanelCommand.Execute(null)">＋</button>
            <label class="round attach @(_uploading ? "busy" : "")" title="Photos and videos">📎<InputFile OnChange="AttachAsync" multiple accept="image/*,video/*" disabled="@_uploading" /></label>
            <input @bind="Vm.Draft" @bind:event="oninput" placeholder="Write your message…" maxlength="4000" autocomplete="off" />
            <button type="submit" class="primary send" title="Send" disabled="@string.IsNullOrWhiteSpace(Vm.Draft)">➤</button>
        </form>
    </section>

    @if (_forwarding is { } forwarding)
    {
        <div class="modal-scrim" @onclick="() => _forwarding = null">
            <div class="forward-sheet glass" @onclick:stopPropagation="true">
                <div class="widget-head"><h3>Forward to…</h3><button class="link" @onclick="() => _forwarding = null">Cancel</button></div>
                <div class="forward-list">
                    @foreach (var chat in Chats.Conversations.Where(c => c.Id != Id))
                    {
                        <label class="forward-row">
                            <input type="checkbox" checked="@_forwardTo.Contains(chat.Id)" @onchange="e => ToggleTarget(chat.Id, (bool)e.Value!)" />
                            <span class="grow">@chat.Title</span>
                        </label>
                    }
                    @if (!Chats.Conversations.Any(c => c.Id != Id))
                    {
                        <p class="muted">No other chats to forward to yet.</p>
                    }
                </div>
                @if (_forwardError is not null)
                {
                    <p class="error">@_forwardError</p>
                }
                <button class="primary wide" disabled="@(_forwardTo.Count == 0 || _busyForward)" @onclick="() => ForwardAsync(forwarding)">
                    @(_busyForward ? "Forwarding…" : _forwardTo.Count > 1 ? $"Forward to {_forwardTo.Count} chats" : "Forward")
                </button>
            </div>
        </div>
    }

    <ExchangePanel ConversationId="Id" Messages="Vm.Messages" @bind-Tab="_tab"
                   CssClass="@((_open ? "open" : "") + (_hidden ? " hidden" : ""))" OnClose="ClosePanel" />

    <nav class="app-rail" aria-label="Chat apps">
        @if (Launcher.Allows(BuiltInApps.Wallet))
        {
            <button class="@(Showing("send-money") ? "on" : "")" @onclick='() => OpenPanel("send-money")'><span class="tile-icon tone-green">$</span>Money</button>
        }
        <button class="@(Showing("transfer") ? "on" : "")" @onclick='() => OpenPanel("transfer")'><span class="tile-icon tone-blue">🪙</span>Tokens</button>
        <button class="@(Showing("history") ? "on" : "")" @onclick='() => OpenPanel("history")'><span class="tile-icon tone-red">🧾</span>History</button>
        @if (Vm.Actions.FirstOrDefault(a => a is StartGigAction) is { } gig)
        {
            <button @onclick="() => Vm.RunActionCommand.ExecuteAsync(gig)"><span class="tile-icon tone-orange">🧰</span>Gig</button>
        }
    </nav>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>?panel=send-money or ?panel=transfer opens the exchange panel on that form (from Home's quick actions).</summary>
    [SupplyParameterFromQuery(Name = "panel")] public string? Panel { get; set; }

    ElementReference _scroller;
    Guid? _lastMessage;
    string _tab = "transfer";
    bool _open, _hidden;

    /// <summary>In a one-to-one chat, the other person.</summary>
    UserDto? Other => Vm.Conversation is { Type: ConversationType.Direct } c ? c.Members.FirstOrDefault(m => m.Id != Session.MyUserId) : null;

    string DefaultTab =>Launcher.Allows(BuiltInApps.Wallet) ? "send-money" : "transfer";

    bool Showing(string tab) => _tab == tab && (_open || !_hidden);

    protected override async Task OnParametersSetAsync()
    {
        _tab = Panel is "send-money" or "transfer" or "history" ? Panel : DefaultTab;
        _open = Panel is not null;
        await Vm.OnNavigatedToAsync(new Dictionary<string, object> { [Routes.ConversationIdParameter] = Id });
        Vm.Activate();
    }

    /// <summary>On wide screens the panel is a column that can be hidden; on narrow ones it slides over the chat.</summary>
    async Task OpenPanel(string tab)
    {
        _tab = tab;
        if (await JS.InvokeAsync<bool>("ndeipi.matches", "(max-width: 1100px)"))
            _open = true;
        else
            _hidden = false;
    }

    void ClosePanel() => (_open, _hidden) = (false, true);

    /// <summary>Money and tokens open the side panel here instead of a separate page.</summary>
    async Task RunAsync(IComposerAction action)
    {
        Vm.ToggleExtensionPanelCommand.Execute(null);
        switch (action)
        {
            case SendMoneyAction:
                await OpenPanel("send-money");
                break;
            case SendTokenAction:
                await OpenPanel("transfer");
                break;
            default:
                await Vm.RunActionCommand.ExecuteAsync(action);
                break;
        }
    }

    /// <summary>A new message at the bottom scrolls into view; older ones loading at the top don't.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var last = Vm.Messages.LastOrDefault()?.ClientMessageId;
        if (last == _lastMessage)
            return;
        _lastMessage = last;
        await JS.InvokeVoidAsync("ndeipi.scrollToBottom", _scroller);
    }

    // ---- Photos and videos (SRS §3.3) ----

    string? _upload;
    bool _uploading, _uploadFailed;

    /// <summary>
    /// Uploads the chosen photos and videos, then sends them as one gallery with the draft as caption.
    /// Photos shrink in the browser first (§4.1, slow connections); the server recompresses them too.
    /// </summary>
    async Task AttachAsync(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(MarketContract.MaxMedia + 1);
        if (files.Count > MarketContract.MaxMedia)
        {
            (_upload, _uploadFailed) = ($"Send up to {MarketContract.MaxMedia} photos or videos at a time.", true);
            return;
        }
        (_uploading, _uploadFailed) = (true, false);
        var items = new List<MediaItem>();
        try
        {
            for (var i = 0; i < files.Count; i++)
            {
                var file = files[i];
                _upload = files.Count == 1 ? "Uploading…" : $"Uploading {i + 1} of {files.Count}…";
                StateHasChanged();
                if (file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                {
                    if (file.Size > MarketContract.MaxVideoBytes)
                        throw new ApiException(null, $"Videos can be up to {MarketContract.MaxVideoBytes / 1024 / 1024} MB. Try a shorter one.");
                    await using var video = file.OpenReadStream(MarketContract.MaxVideoBytes);
                    items.Add(await Api.UploadChatMediaAsync(Id, video, file.Name, file.ContentType));
                }
                else
                {
                    using var original = new MemoryStream();
                    await file.OpenReadStream(MarketContract.MaxImageBytes).CopyToAsync(original);
                    var shrunk = await JS.InvokeAsync<byte[]>("ndeipi.shrinkImage", original.ToArray(), 1600, 0.82);
                    items.Add(await Api.UploadChatMediaAsync(Id, new MemoryStream(shrunk), "photo.jpg", "image/jpeg"));
                }
            }
            _upload = null;
            await Vm.SendMediaAsync(items);
        }
        catch (Exception ex) when (ex is ApiException or IOException or JSException)
        {
            (_upload, _uploadFailed) = (ex is ApiException ? ex.Message : "Couldn't read that file. Please try again.", true);
        }
        finally
        {
            _uploading = false;
        }
    }

    // ---- Forwarding (SRS §3.2) ----

    MessageViewModel? _forwarding;
    readonly HashSet<Guid> _forwardTo = [];
    bool _busyForward;
    string? _forwardError;

    async Task StartForward(MessageViewModel message)
    {
        (_forwarding, _forwardError) = (message, null);
        _forwardTo.Clear();
        if (Chats.Conversations.Count == 0)
            await Chats.RefreshCommand.ExecuteAsync(null);
    }

    void ToggleTarget(Guid id, bool on)
    {
        if (on)
            _forwardTo.Add(id);
        else
            _forwardTo.Remove(id);
    }

    async Task ForwardAsync(MessageViewModel message)
    {
        (_busyForward, _forwardError) = (true, null);
        try
        {
            await Api.ForwardAsync(message.Id, _forwardTo.ToList());
            _forwarding = null;
            _upload = _forwardTo.Count == 1 ? "Forwarded." : $"Forwarded to {_forwardTo.Count} chats.";
            _uploadFailed = false;
        }
        catch (ApiException ex)
        {
            _forwardError = ex.Message;
        }
        finally
        {
            _busyForward = false;
        }
    }

    public override void Dispose()
    {
        Vm.Deactivate();
        Vm.Dispose();
        base.Dispose();
    }
}
