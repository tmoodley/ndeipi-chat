@page "/feed"
@inject ChatApi Api
@inject ChatSession Session
@inject SocialActions Social
@inject IServiceProvider Services
@inject NavigationManager Navigation

@* Social: your profile at the top; then the feed (everyone, or people you follow and your groups),
   your groups, people to find, and your photos. *@

<PageTitle>Social · Ndeipi</PageTitle>

<div class="sc-page">
    @if (_me is { } me)
    {
        <ProfileHero Profile="me" StatClicked="OnStat">
            <Actions>
                <a class="button btn-a" href="u/@me.User.Id">View profile</a>
                <a class="button btn-b" href="feed/new">New post</a>
            </Actions>
        </ProfileHero>
    }

    <nav class="sc-tabs glass">
        <button class="sc-tab @On("foryou")" @onclick='() => GoAsync("foryou")'><span class="ico">🏠</span>For you</button>
        <button class="sc-tab @On("following")" @onclick='() => GoAsync("following")'><span class="ico">⭐</span>Following</button>
        <button class="sc-tab @On("groups")" @onclick='() => GoAsync("groups")'><span class="ico">👥</span>Groups</button>
        <button class="sc-tab @On("people")" @onclick='() => GoAsync("people")'><span class="ico">🧭</span>People</button>
        <button class="sc-tab @On("photos")" @onclick='() => GoAsync("photos")'><span class="ico">🖼️</span>Photos</button>
    </nav>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @switch (_tab)
    {
        case "foryou" or "following":
            <div class="sc-grid">
                <div class="sc-col side">
                    @if (_me is { } about)
                    {
                        <section class="widget glass">
                            <div class="widget-head"><h3>About me</h3><a href="u/@about.User.Id?tab=about&edit=info">Edit</a></div>
                            <p style="margin: 0">@(about.Bio ?? "Say a little about yourself on your profile.")</p>
                            <dl class="facts">
                                <dt>Joined</dt><dd>@about.JoinedAt.ToLocalTime().ToString("d MMMM yyyy")</dd>
                                @if (about.City is { } city)
                                {
                                    <dt>City</dt><dd>@city</dd>
                                }
                                @if (about.Website is { } web)
                                {
                                    <dt>Web</dt><dd><a href="@web" target="_blank" rel="noopener">@(new Uri(web).Host)</a></dd>
                                }
                            </dl>
                        </section>
                    }
                    <section class="widget glass">
                        <div class="widget-head"><h3>My groups<em>@_myGroups.Count</em></h3><button @onclick='() => GoAsync("groups")'>See all</button></div>
                        @foreach (var g in _myGroups.Take(6))
                        {
                            <a class="mini-row" href="groups/@g.Id" @key="g.Id">
                                <HexAvatar Url="@g.AvatarUrl" Icon="@g.Icon" Tone="@("tone-" + g.Tone)" Size="44" Class="icon-hex" />
                                <span class="grow"><strong>@g.Name</strong><small>@g.MemberCount members</small></span>
                            </a>
                        }
                        @if (_myGroups.Count == 0)
                        {
                            <p class="muted small" style="margin: 0">Join a group or start one under Groups.</p>
                        }
                    </section>
                </div>

                <div class="sc-col">
                    <SocialFeed Feed="_feed" Empty="@(_tab == "following" ? "Follow people or join groups, and their posts show up here." : "No posts yet. Be the first!")" />
                </div>

                <div class="sc-col side">
                    <section class="widget glass">
                        <div class="widget-head"><h3>Following<em>@_following.Count</em></h3></div>
                        @foreach (var p in _following.Take(8))
                        {
                            <div class="mini-row" @key="p.User.Id">
                                <a href="u/@p.User.Id"><HexAvatar Url="@p.User.AvatarUrl" Initials="@Display.Initials(p.User.DisplayName)" Tone="@SocialActions.ToneFor(p.User.Id)" Size="44" /></a>
                                <a class="grow" href="u/@p.User.Id" style="color: var(--text)"><strong>@p.User.DisplayName</strong><small>@(p.Bio ?? $"{p.PostCount} posts")</small></a>
                                @if (Social.CanChat)
                                {
                                    <button class="round-btn" title="Message" @onclick="() => Social.MessageAsync(p.User.Id)">💬</button>
                                }
                            </div>
                        }
                        @if (_following.Count == 0)
                        {
                            <p class="muted small" style="margin: 0">Nobody yet. Find people under People.</p>
                        }
                    </section>
                    <section class="widget glass">
                        <div class="widget-head"><h3>People to follow</h3><button @onclick='() => GoAsync("people")'>More</button></div>
                        @foreach (var p in _suggested.Take(5))
                        {
                            <div class="mini-row" @key="p.User.Id">
                                <a href="u/@p.User.Id"><HexAvatar Url="@p.User.AvatarUrl" Initials="@Display.Initials(p.User.DisplayName)" Tone="@SocialActions.ToneFor(p.User.Id)" Size="44" /></a>
                                <a class="grow" href="u/@p.User.Id" style="color: var(--text)"><strong>@p.User.DisplayName</strong><small>@p.FollowerCount followers</small></a>
                                <button class="round-btn" title="Follow" @onclick="() => FollowAsync(p)">＋</button>
                            </div>
                        }
                    </section>
                </div>
            </div>
            break;

        case "groups":
            <div class="sc-section-head">
                <div><div class="kicker">Account hub</div><div class="big">Manage groups<em>@_myGroups.Count</em></div></div>
            </div>
            <div class="card-grid">
                <article class="create-card glass">
                    <div class="strip"></div>
                    <button class="dash-hex" style="padding: 0; box-shadow: none; background: var(--divider); width: 92px; height: 101px; border-radius: 0" title="Create a group" @onclick="() => OpenEditorAsync(null)"><span>＋</span></button>
                    <div class="who">Create a new group</div>
                    <div class="bio">Share your interests with others and start a community. Add a cover, rules and members.</div>
                    <button class="btn-a" @onclick="() => OpenEditorAsync(null)">Start creating!</button>
                </article>
                @foreach (var g in _myGroups)
                {
                    <GroupCard @key="g.Id" Group="g" Manage="OpenEditorAsync" />
                }
            </div>

            <div class="sc-section-head" style="margin-top: 12px">
                <div><div class="kicker">Browse groups</div><div class="big">Discover<em>@Discover.Count</em></div></div>
            </div>
            <div class="sc-filter glass">
                <input type="search" placeholder="Search groups" @bind="_groupQuery" @bind:event="oninput" @bind:after="LoadGroupsAsync" />
            </div>
            <div class="card-grid">
                @foreach (var g in Discover)
                {
                    <GroupCard @key="g.Id" Group="g" Join="JoinAsync" Joining="_busy" />
                }
            </div>
            @if (Discover.Count == 0)
            {
                <div class="empty"><p>@(_groupQuery.Length > 0 ? "No groups found." : "You're in every group there is. Start another!")</p></div>
            }
            break;

        case "people":
            <div class="sc-section-head">
                <div><div class="kicker">Find people</div><div class="big">People<em>@_people.Count</em></div></div>
            </div>
            <div class="sc-filter glass">
                <input type="search" placeholder="Search by name" @bind="_peopleQuery" @bind:event="oninput" @bind:after="LoadPeopleAsync" />
                <div class="seg">
                    <button class="@(_peopleMode == "suggested" ? "on" : "")" @onclick='() => SetPeopleModeAsync("suggested")'>Suggested</button>
                    <button class="@(_peopleMode == "following" ? "on" : "")" @onclick='() => SetPeopleModeAsync("following")'>Following</button>
                    <button class="@(_peopleMode == "followers" ? "on" : "")" @onclick='() => SetPeopleModeAsync("followers")'>Followers</button>
                </div>
            </div>
            <div class="card-grid">
                @foreach (var p in _people)
                {
                    <PersonCard @key="p.User.Id" Person="p" />
                }
            </div>
            @if (_people.Count == 0)
            {
                <div class="empty"><p>Nobody here yet.</p></div>
            }
            break;

        case "photos":
            <div class="sc-section-head">
                <div><div class="kicker">Your</div><div class="big">Photos<em>@(_me?.Photos.Count ?? 0)</em></div></div>
                <div class="links"><a href="feed/new">Upload photos +</a></div>
            </div>
            @if (_me is { Photos.Count: > 0 } withPhotos)
            {
                <div class="album-grid">
                    @foreach (var photo in withPhotos.Photos)
                    {
                        <a class="album" @key="photo.Id" href="@photo.Url.Replace("/thumb", "/full")" target="_blank" rel="noopener">
                            <span class="art" style="background: url('@photo.Url') center / cover"></span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="empty"><p>Photos you post show up here.</p></div>
            }
            break;
    }

    @if (_editing)
    {
        <GroupEditor Group="_editGroup" Saved="OnGroupSaved" Closed="() => _editing = false" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    FeedViewModel _feed = null!;
    SocialProfileDto? _me;
    List<GroupSummaryDto> _myGroups = [], _groups = [];
    List<PersonCardDto> _following = [], _suggested = [], _people = [];
    string _tab = "foryou", _groupQuery = "", _peopleQuery = "", _peopleMode = "suggested";
    string? _error;
    bool _busy, _editing;
    GroupDetailDto? _editGroup;

    List<GroupSummaryDto> Discover => _groups.Where(g => !g.IsMember).ToList();

    string On(string tab) => _tab == tab ? "on" : "";

    protected override async Task OnInitializedAsync()
    {
        _feed = ActivatorUtilities.CreateInstance<FeedViewModel>(Services);
        _tab = Tab is "following" or "groups" or "people" or "photos" ? Tab : "foryou";
        await Task.WhenAll(LoadMeAsync(), LoadTabAsync());
    }

    async Task LoadMeAsync()
    {
        await Run(async () =>
        {
            var meId = Session.MyUserId;
            _me = await Api.GetJsonAsync<SocialProfileDto>($"{SocialActions.Base}/profiles/{meId}");
            _myGroups = await Api.GetJsonAsync<List<GroupSummaryDto>>($"{SocialActions.Base}/groups?mine=true");
            _following = await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/profiles/{meId}/following");
            _suggested = await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/people");
        });
    }

    async Task GoAsync(string tab)
    {
        _tab = tab;
        Navigation.NavigateTo(tab == "foryou" ? "feed" : $"feed?tab={tab}", replace: true);
        await LoadTabAsync();
    }

    Task OnStat(string stat) => stat switch
    {
        "groups" => GoAsync("groups"),
        "followers" => SetPeopleModeAndGoAsync("followers"),
        "following" => SetPeopleModeAndGoAsync("following"),
        _ => Task.CompletedTask
    };

    async Task SetPeopleModeAndGoAsync(string mode)
    {
        _peopleMode = mode;
        await GoAsync("people");
    }

    Task LoadTabAsync() => _tab switch
    {
        "groups" => LoadGroupsAsync(),
        "people" => LoadPeopleAsync(),
        "photos" => Task.CompletedTask,
        _ => LoadFeedAsync()
    };

    async Task LoadFeedAsync()
    {
        _feed.Scope = _tab == "following" ? FeedScopes.Following : null;
        await _feed.RefreshCommand.ExecuteAsync(null);
    }

    Task LoadGroupsAsync() => Run(async () =>
        _groups = await Api.GetJsonAsync<List<GroupSummaryDto>>($"{SocialActions.Base}/groups?mine=false&q={Uri.EscapeDataString(_groupQuery)}"));

    /// <summary>Opens the group window: on a group you run, or on a new one.</summary>
    async Task OpenEditorAsync(GroupSummaryDto? group)
    {
        _editGroup = null;
        if (group is not null)
        {
            await Run(async () => _editGroup = await Api.GetJsonAsync<GroupDetailDto>($"{SocialActions.Base}/groups/{group.Id}"));
            if (_editGroup is null)
                return;
        }
        _editing = true;
    }

    void OnGroupSaved(GroupDetailDto saved)
    {
        _editGroup = saved;
        var i = _myGroups.FindIndex(g => g.Id == saved.Group.Id);
        if (i >= 0)
            _myGroups[i] = saved.Group;
        else
            _myGroups.Insert(0, saved.Group);
    }

    async Task SetPeopleModeAsync(string mode)
    {
        _peopleMode = mode;
        await LoadPeopleAsync();
    }

    Task LoadPeopleAsync() => Run(async () =>
    {
        var meId = Session.MyUserId;
        _people = _peopleQuery.Length > 0 || _peopleMode == "suggested"
            ? await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/people?q={Uri.EscapeDataString(_peopleQuery)}")
            : await Api.GetJsonAsync<List<PersonCardDto>>($"{SocialActions.Base}/profiles/{meId}/{_peopleMode}");
    });

    async Task FollowAsync(PersonCardDto person)
    {
        await Run(async () =>
        {
            await Social.FollowAsync(person.User.Id, true);
            _suggested.Remove(person);
            _following.Insert(0, person with { IFollow = true });
        });
    }

    async Task JoinAsync(GroupSummaryDto group) => await Run(async () =>
    {
        var joined = await Api.SendJsonAsync<GroupDetailDto>(HttpMethod.Post, $"{SocialActions.Base}/groups/{group.Id}/join");
        _groups[_groups.IndexOf(group)] = joined.Group;
        _myGroups.Add(joined.Group);
    });

    async Task Run(Func<Task> work)
    {
        (_busy, _error) = (true, null);
        try
        {
            await work();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
