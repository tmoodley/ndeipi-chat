@page "/chats"
@inherits ViewModelPage<ChatsViewModel>

<PageTitle>Chats · Ndeipi</PageTitle>

<div class="messenger">
    <ChatList />
    <section class="conversation placeholder">
        <div class="empty" style="margin: auto">
            <span class="tile-icon tone-blue" style="width: 72px; height: 72px; font-size: 34px; border-radius: 24px">💬</span>
            <h3>Pick a chat</h3>
            <p>Or start one with a Shamwari. Money and tokens can be sent from any chat.</p>
            <a class="button primary" href="shamwaris">New chat</a>
        </div>
    </section>
</div>

@code {
    protected override Task OnInitializedAsync() => Vm.RefreshCommand.ExecuteAsync(null);
}
