@inherits LayoutComponentBase
@implements IDisposable
@inject AppCoordinator Coordinator
@inject AuthService Auth
@inject ChatSession Session
@inject ChatsViewModel Chats
@inject ContactsViewModel Contacts
@inject LauncherViewModel Launcher
@inject WebEmbedding Embedding
@inject WebDispatcher Dispatcher
@inject NavigationManager Navigation
@inject ShellUi Ui

@if (!_started)
{
    <div class="splash"><div class="logo">N</div></div>
}
else if (IsSignInPage)
{
    @Body
}
else if (!_signedIn)
{
    @* On the way to the sign-in page: don't let the page asked for load and call the API. *@
    <div class="splash"><div class="logo">N</div></div>
}
else if (Embedding.IsEmbedded)
{
    @* In the phone app's WebView, showing one sub-app: the app is the shell, so no navigation here. *@
    <main class="content embedded">@Body</main>
}
else
{
    <div class="shell">
        @* Wide screens: a glass rail of icons. Phones: a floating dock with a raised Home in the
           middle. Either way, More opens the apps drawer with everything else. *@
        <nav class="rail" aria-label="Apps">
            <a class="logo small" href="" title="Home">N</a>
            <NavLink href="" Match="NavLinkMatch.All" class="rail-item" title="Home">🏠</NavLink>
            @foreach (var app in RailApps)
            {
                <NavLink href="@app.Route" class="rail-item" title="@app.Title" @key="app.Id">
                    @app.Icon
                    @if (BadgeFor(app.Id) is { } badge)
                    {
                        <span class="badge">@badge</span>
                    }
                </NavLink>
            }
            <button class="rail-item" title="All apps" @onclick="() => Ui.OpenDrawer()">▦</button>
            <div class="rail-spacer"></div>
            <button class="rail-item" title="@(Ui.IsDark ? "Light mode" : "Dark mode")" @onclick="() => Ui.SetDarkAsync(!Ui.IsDark)">@(Ui.IsDark ? "☀️" : "🌙")</button>
            <a href="me" title="You">
                <Avatar Url="@Session.Me?.AvatarUrl" Initials="@Display.Initials(Session.Me?.DisplayName ?? "N")" Size="46" />
            </a>
        </nav>

        <main class="content @(IsInChat ? "in-chat" : "")">
            @if (Session.Connection.State is not Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
            {
                <div class="offline">Connecting…</div>
            }
            @if (DeniedApp is not null)
            {
                <div class="empty">
                    <h2>You don't have access to this app</h2>
                    <p>It isn't switched on for your account. Ask your administrator if you need it.</p>
                    <a class="button primary" href="">Back to your apps</a>
                </div>
            }
            else
            {
                @Body
            }
        </main>

        @if (!IsInChat)
        {
            <nav class="dock" aria-label="Apps">
                @foreach (var app in DockApps.Take(2))
                {
                    <DockLink App="app" Badge="@BadgeFor(app.Id)" @key="app.Id" />
                }
                <NavLink href="" Match="NavLinkMatch.All" class="dock-home-wrap" ActiveClass="active">
                    <span class="dock-home">🏠</span>
                    <span>Home</span>
                </NavLink>
                @foreach (var app in DockApps.Skip(2).Take(1))
                {
                    <DockLink App="app" Badge="@BadgeFor(app.Id)" @key="app.Id" />
                }
                <button class="dock-item" @onclick="() => Ui.OpenDrawer()">
                    <span class="icon">⋯</span>
                    <span>More</span>
                </button>
            </nav>
        }

        <AppsDrawer />
    </div>
}

@code {
    /// <summary>Apps on the rail after Home: the core ones this user has, then their pins.</summary>
    const int MaxRailApps = 7;

    static readonly string[] CoreApps = [BuiltInApps.Chats, BuiltInApps.Feed, BuiltInApps.Shamwaris, BuiltInApps.Wallet];

    IEnumerable<SubAppItemViewModel> WebApps => Launcher.Apps.Where(a => WebSubApps.HasPages(a.Route));

    IEnumerable<SubAppItemViewModel> RailApps => CoreApps.Select(id => WebApps.FirstOrDefault(a => a.Id == id)).OfType<SubAppItemViewModel>()
        .Concat(Launcher.Pinned.Where(a => WebSubApps.HasPages(a.Route) && !CoreApps.Contains(a.Id)))
        .Take(MaxRailApps);

    /// <summary>The dock's three app slots around Home: Chats, Feed and Wallet when allowed, then pins.</summary>
    IEnumerable<SubAppItemViewModel> DockApps => new[] { BuiltInApps.Chats, BuiltInApps.Feed, BuiltInApps.Wallet }
        .Select(id => WebApps.FirstOrDefault(a => a.Id == id)).OfType<SubAppItemViewModel>()
        .Concat(Launcher.Pinned.Where(a => WebSubApps.HasPages(a.Route)))
        .DistinctBy(a => a.Id)
        .Take(3);

    /// <summary>A conversation fills a phone's screen with its composer at the bottom, so the dock steps aside.</summary>
    bool IsInChat => RelativePath.StartsWith("chat/", StringComparison.OrdinalIgnoreCase);

    bool _started, _signedIn;

    string RelativePath => Navigation.ToBaseRelativePath(Navigation.Uri);

    bool IsSignInPage => RelativePath.Split('?', '#')[0].TrimEnd('/') is WebNavigator.SignInPath or WebNavigator.CallbackPath;

    bool IsCallbackPage => RelativePath.Split('?', '#')[0].TrimEnd('/') is WebNavigator.CallbackPath;

    /// <summary>
    /// The sub-app on screen, if the manifest leaves it out: the user's roles don't allow it, or it's
    /// switched off. The API refuses it too; this just says so instead of showing errors.
    /// </summary>
    string? DeniedApp => Launcher.IsLoaded && WebSubApps.OwnerOf(RelativePath) is { } owner && !Launcher.Allows(owner)
        ? owner
        : null;

    string? BadgeFor(string appId) => appId switch
    {
        BuiltInApps.Chats when Chats.TotalUnread > 0 => Chats.TotalUnread > 99 ? "99+" : Chats.TotalUnread.ToString(),
        BuiltInApps.Shamwaris when Contacts.Incoming.Count > 0 => Contacts.Incoming.Count.ToString(),
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Dispatcher.Changed += Refresh;
        Session.Connection.StateChanged += Refresh;
        Launcher.ManifestChanged += Refresh;
        Ui.Changed += Refresh;
        _ = Ui.LoadThemeAsync();

        // Signed in: connect and stay on the page asked for. Otherwise: the sign-in page. Not on the
        // sign-in callback, though: that page signs in with what it was handed (from the phone app,
        // a fresh handoff) and starts things itself. Starting here too would go ahead with whatever
        // sign-in was saved before, and leave for Home before the callback ever ran.
        if (!IsCallbackPage)
        {
            try
            {
                await Coordinator.StartAsync();
            }
            catch (ApiException)
            {
                // A saved sign-in the server no longer accepts; AuthService has already cleared it.
                if (Embedding.IsInApp)
                    WebEmbedding.RequestSignIn(Navigation);
                else
                    Navigation.NavigateTo(WebNavigator.SignInPath, replace: true);
            }
        }
        // The manifest before any page: it decides which pages this user may see.
        _signedIn = await Auth.IsSignedInAsync();
        if (_signedIn)
            await LoadAppsAsync();
        _started = true;
    }

    /// <summary>The manifest, then the badges of the apps it allows.</summary>
    async Task LoadAppsAsync()
    {
        await Launcher.LoadCommand.ExecuteAsync(null);
        if (Launcher.Allows(BuiltInApps.Chats))
            _ = Chats.RefreshCommand.ExecuteAsync(null);
        if (Launcher.Allows(BuiltInApps.Shamwaris))
            _ = Contacts.LoadCommand.ExecuteAsync(null);
    }

    /// <summary>Signing in or out always ends in a navigation, so that's when to look again.</summary>
    void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        var wasSignedIn = _signedIn;
        _signedIn = await Auth.IsSignedInAsync();
        if (_signedIn && !wasSignedIn)
            await LoadAppsAsync();
        StateHasChanged();
    });

    void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Dispatcher.Changed -= Refresh;
        Session.Connection.StateChanged -= Refresh;
        Launcher.ManifestChanged -= Refresh;
        Ui.Changed -= Refresh;
    }
}
