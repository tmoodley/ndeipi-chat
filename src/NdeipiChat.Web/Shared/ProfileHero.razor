@* A profile's header: cover banner (a photo, or their colour), hexagon avatar over it, stats on one
   side, actions and their other networks on the other. *@
<section class="sc-hero glass">
    <div class="sc-cover @(Profile.CoverUrl is null ? SocialActions.ToneFor(Profile.User.Id) : "has-image")" style="@(Profile.CoverUrl is { } cover ? $"background-image: url('{cover}')" : "")"></div>
    <div class="sc-hero-body">
        <div class="sc-stats">
            <button class="sc-stat" @onclick='() => StatClicked.InvokeAsync("timeline")'><b>@Profile.PostCount</b><span>Posts</span></button>
            <button class="sc-stat" @onclick='() => StatClicked.InvokeAsync("followers")'><b>@Profile.FollowerCount</b><span>Followers</span></button>
            <button class="sc-stat" @onclick='() => StatClicked.InvokeAsync("following")'><b>@Profile.FollowingCount</b><span>Following</span></button>
            <button class="sc-stat" @onclick='() => StatClicked.InvokeAsync("groups")'><b>@Profile.GroupCount</b><span>Groups</span></button>
        </div>
        <div class="sc-center">
            <HexAvatar Url="@Profile.User.AvatarUrl" Initials="@Display.Initials(Profile.User.DisplayName)" Tone="@SocialActions.ToneFor(Profile.User.Id)" Size="128"
                       Badge="@(Profile.IsShamwari ? "✓" : Profile.Gig is { Rating: { } r } ? $"★{r:0.#}" : null)" />
            <div class="sc-identity">
                <div class="name">@Profile.User.DisplayName</div>
                <div class="sub">@SubLine</div>
                <TrustBadge UserId="Profile.User.Id" Large Live Href="@(Profile.IsMe ? TrustContract.PagePath : null)" />
            </div>
        </div>
        <div class="sc-actions">
            @Actions
            <LinkIcons Links="@(Profile.Details?.Links ?? [])" />
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SocialProfileDto Profile { get; set; } = null!;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback<string> StatClicked { get; set; }

    string SubLine => Profile.Details?.Occupation is { } job
        ? Profile.City is { } city ? $"{job} · {city}" : job
        : Profile.Website is { } w && Uri.TryCreate(w, UriKind.Absolute, out var site)
            ? site.Host
            : Profile.City ?? (Profile.User.Username is { } u ? "@" + u : "Ndeipi");
}
