@* A group as a card: its cover (or colour), its avatar (or icon) in a hexagon, members and posts,
   and Manage (your own), Open (a member) or Join / View. *@
<article class="person-card glass">
    <div class="strip @(Group.CoverUrl is not null ? "has-image" : "tone-" + Group.Tone)" style="@(Group.CoverUrl is { } u ? $"background-image: url('{u}')" : "")"></div>
    <a href="groups/@Group.Id">
        <HexAvatar Url="@Group.AvatarUrl" Icon="@Group.Icon" Tone="@("tone-" + Group.Tone)" Size="92" Class="icon-hex" />
    </a>
    <a class="who" href="groups/@Group.Id">@Group.Name</a>
    @if (Group.IsMember)
    {
        <div class="role">@(Group.MyRole == GroupRoles.Owner ? "Group organizer" : "Member")@(Group.IsPrivate ? " · 🔒 Private" : "")</div>
    }
    <div class="bio">@(!Group.IsMember && Group.IsPrivate ? "🔒 Private · " : "")@(Group.Tagline ?? Group.Description)</div>
    <div class="sc-stats">
        <div class="sc-stat"><b>@Group.MemberCount</b><span>Members</span></div>
        <div class="sc-stat"><b>@Group.PostCount</b><span>Posts</span></div>
    </div>
    <div class="pair">
        @if (Group.MyRole == GroupRoles.Owner && Manage.HasDelegate)
        {
            <button class="btn-a manage" @onclick="() => Manage.InvokeAsync(Group)">Manage group</button>
        }
        else if (Group.IsMember)
        {
            <a class="button btn-b" href="groups/@Group.Id">Open</a>
        }
        else
        {
            <button class="btn-a" disabled="@(Group.IsPrivate || Joining)" @onclick="() => Join.InvokeAsync(Group)">@(Group.IsPrivate ? "Invite only" : "Join +")</button>
            <a class="button secondary" href="groups/@Group.Id">View</a>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public GroupSummaryDto Group { get; set; } = null!;
    [Parameter] public EventCallback<GroupSummaryDto> Join { get; set; }
    [Parameter] public bool Joining { get; set; }

    /// <summary>Set to show "Manage group" on groups you run.</summary>
    [Parameter] public EventCallback<GroupSummaryDto> Manage { get; set; }
}
