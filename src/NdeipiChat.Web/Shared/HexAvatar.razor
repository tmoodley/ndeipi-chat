@* A hexagon avatar with a gradient ring; the badge is an optional small number or mark. *@
<span class="hex @Class" style="--size:@(Size)px">
    <span class="hex-ring"></span>
    <span class="hex-inner">
        @* Initials (or the icon) first, then the photo over them, faded in once it has arrived: the
           avatar is never an empty hole while the photo downloads. *@
        <span class="initials @Tone">@(Icon ?? Initials)</span>
        @if (Url is not null)
        {
            <img src="@Url" alt="" onload="this.classList.add('ready')" />
        }
    </span>
    @if (Badge is not null)
    {
        <span class="hex-badge">@Badge</span>
    }
</span>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Initials { get; set; } = "";

    /// <summary>An emoji instead of initials, for groups.</summary>
    [Parameter] public string? Icon { get; set; }

    [Parameter] public string Tone { get; set; } = "tone-purple";
    [Parameter] public int Size { get; set; } = 96;
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string? Class { get; set; }
}
