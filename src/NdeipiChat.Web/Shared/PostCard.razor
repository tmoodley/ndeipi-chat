@* One post: author, photos (swipe or scroll sideways when there are several), likes, caption, NFT. *@
<article class="post">
    <header class="post-head">
        <a href="u/@Post.Post.Author.Id">
            <HexAvatar Url="@Post.AuthorAvatarUrl" Initials="@Post.AuthorInitials" Tone="@SocialActions.ToneFor(Post.Post.Author.Id)" Size="44" />
        </a>
        <div class="row-main">
            <a class="name name-link" href="u/@Post.Post.Author.Id">@Post.AuthorName</a>
            <span class="time">
                <a class="time" href="posts/@Post.Id">@Post.TimeText</a>
                @if (Post.Post.Group is { } group)
                {
                    <text> · </text><a class="group-chip" href="groups/@group.Id">in @group.Name</a>
                }
            </span>
        </div>
        @if (Post.CanDelete)
        {
            <button class="link danger" disabled="@Post.IsBusy" @onclick="DeleteAsync">Delete</button>
        }
    </header>

    @if (Post.Photos.Count == 0 && Post.HasCaption)
    {
        @* A text post: the words are the post. *@
        <p class="caption" style="font-size: 17px; margin-top: 2px">@Post.Caption</p>
    }
    <div class="post-photos @(Post.HasSeveralPhotos ? "several" : "")" style="@(Post.Photos.Count == 0 ? "display:none" : "")">
        @foreach (var photo in Post.Photos)
        {
            <img src="@photo.Url" alt="" loading="lazy" width="@photo.Width" height="@photo.Height"
                 style="aspect-ratio:@photo.Width/@photo.Height" />
        }
    </div>
    @if (Post.HasSeveralPhotos)
    {
        <div class="post-count">@Post.Photos.Count photos · scroll sideways</div>
    }

    <div class="post-actions">
        <button class="like @(Post.LikedByMe ? "liked" : "")" title="@(Post.LikedByMe ? "Unlike" : "Like")"
                @onclick="() => Feed.ToggleLikeCommand.ExecuteAsync(Post)">@(Post.LikedByMe ? "♥" : "♡")</button>
        <span class="likes">@Post.LikeText</span>
        @if (Post.CanMint)
        {
            <button class="secondary small mint" disabled="@Post.IsBusy" @onclick="() => Feed.MintCommand.ExecuteAsync(Post)">⬡ @Post.MintText</button>
        }
    </div>

    @if (Post.HasCaption && Post.Photos.Count > 0)
    {
        <p class="caption"><strong>@Post.AuthorName</strong> @Post.Caption</p>
    }

    @if (Post.HasNft)
    {
        <div class="nft @(Post.IsMinted ? "minted" : "")">
            <span>⬡ @Post.NftText</span>
            @if (Post.Nft is { } nft)
            {
                <a href="@nft.MetadataUrl" target="_blank" rel="noopener">Metadata</a>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public PostItemViewModel Post { get; set; } = null!;
    [Parameter, EditorRequired] public FeedViewModel Feed { get; set; } = null!;
    [Parameter] public EventCallback Deleted { get; set; }
    [Inject] IJSRuntime JS { get; set; } = null!;

    async Task DeleteAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this post? This can't be undone."))
            return;
        await Feed.DeleteCommand.ExecuteAsync(Post);
        await Deleted.InvokeAsync();
    }
}
