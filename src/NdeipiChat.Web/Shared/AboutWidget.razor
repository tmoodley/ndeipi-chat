@* "About me" on a profile: the bio, and when they joined, where they are, what they do, their site
   and their other networks. *@
<section class="widget glass">
    <div class="widget-head">
        <h3>About @(Profile.IsMe ? "me" : Profile.User.DisplayName.Split(' ')[0])</h3>
        @if (Profile.IsMe && Edit.HasDelegate)
        {
            <button @onclick="() => Edit.InvokeAsync()">Edit</button>
        }
    </div>
    <p style="margin: 0; line-height: 1.6">@(Profile.Bio ?? (Profile.IsMe ? "Add a few lines about yourself with Edit profile." : "No bio yet."))</p>
    <dl class="facts">
        <dt>Joined</dt><dd>@Profile.JoinedAt.ToLocalTime().ToString("d MMMM yyyy")</dd>
        @if (Profile.Details?.Occupation is { } occupation)
        {
            <dt>Occupation</dt><dd>@occupation</dd>
        }
        @if (Profile.City is { } city)
        {
            <dt>City</dt><dd>@city</dd>
        }
        @if (Profile.Details?.Country is { } country)
        {
            <dt>Country</dt><dd>@country</dd>
        }
        @if (Profile.Website is { } web && Uri.TryCreate(web, UriKind.Absolute, out var site))
        {
            <dt>Web</dt><dd><a href="@web" target="_blank" rel="noopener">@site.Host</a></dd>
        }
        @if (Profile.User.Username is { } username)
        {
            <dt>Username</dt><dd>@@@username</dd>
        }
    </dl>
    <LinkIcons Links="@(Profile.Details?.Links ?? [])" />
</section>

@code {
    [Parameter, EditorRequired] public SocialProfileDto Profile { get; set; } = null!;

    /// <summary>Shows Edit on your own profile.</summary>
    [Parameter] public EventCallback Edit { get; set; }
}
