@implements IAsyncDisposable

@* Lets Travel (Hotel & Tours Booking SRS): find stays and tours, book and pay from the Ndeipi wallet,
   and travel on an offline QR voucher; vendors list and run their properties and tours in the vendor
   portal. Opened at a booking with "booking={id}", a stay with "property={id}" or a tour with "tour={id}". *@
@attribute [SubAppRoot(TravelContract.AppId)]

<style>
    .content.embedded header.lt-bar { display: none; }
    .lt { --lt-solid: #fff; --lt-star: #F04E3E; }
    :root[data-theme="dark"] .lt { --lt-solid: #1C2134; }
    @@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .lt { --lt-solid: #1C2134; } }
    .lt .page { max-width: 1120px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; padding-bottom: 40px; }
    .lt h2 { font-size: 22px; font-weight: 800; margin: 0; text-transform: none; letter-spacing: 0; color: var(--text); }
    .lt h3 { font-size: 16px; font-weight: 800; margin: 0; text-transform: none; letter-spacing: 0; color: var(--text); }
    .lt .muted { color: var(--muted); }
    .lt .small { font-size: 13px; }
    .lt-tabs { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
    .lt-tabs.center { justify-content: center; }
    .lt-tabs button { flex: none; border-radius: 10px; padding: 9px 20px; font-size: 15px; font-weight: 500; background: var(--lt-solid); color: var(--text); border: 1px solid var(--divider); box-shadow: 0 1px 2px rgba(16, 24, 40, .06); white-space: nowrap; }
    .lt-tabs button:hover:not(.on) { border-color: var(--brand); color: var(--brand); }
    .lt-chips button { flex: none; border-radius: 18px; padding: 7px 14px; font-size: 14px; background: var(--secondary); color: var(--text); box-shadow: none; white-space: nowrap; }
    .lt-tabs button.on, .lt-chips button.on { background: var(--brand); border-color: var(--brand); color: #fff; font-weight: 600; }

    /* The app's own header: brand on the left, its three places on the right. */
    .lt-nav { display: flex; align-items: center; gap: 18px; padding: 4px 2px 6px; border-bottom: 1px solid var(--divider); }
    .lt-nav .brand { font-size: 19px; font-weight: 800; letter-spacing: -.01em; color: var(--text); display: flex; align-items: center; gap: 8px; margin-right: auto; }
    .lt-nav .brand i { width: 30px; height: 30px; border-radius: 9px; background: linear-gradient(135deg, var(--brand), #7C3AED); color: #fff; display: grid; place-items: center; font-style: normal; font-size: 16px; }
    .lt-nav nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
    .lt-nav nav button { background: none; box-shadow: none; border-radius: 0; padding: 10px 10px; font-size: 15px; font-weight: 500; color: var(--muted); border-bottom: 2px solid transparent; white-space: nowrap; }
    .lt-nav nav button:hover { color: var(--text); }
    .lt-nav nav button.on { color: var(--text); font-weight: 700; border-bottom-color: var(--brand); }

    /* Explore: the hero, its search bar, the two feature cards, destinations and recommendations. */
    .lt-heroband { position: relative; border-radius: 24px; overflow: hidden; min-height: 300px; display: grid; place-items: center; text-align: center; color: #fff; background: #1E3A8A center / cover no-repeat; }
    .lt-heroband .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
    .lt-heroband .inner { position: relative; padding: 36px 20px 74px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .lt-heroband h1 { margin: 0; font-size: clamp(32px, 5.4vw, 58px); font-weight: 800; letter-spacing: -.02em; line-height: 1.05; text-shadow: 0 2px 18px rgba(0, 0, 0, .25); }
    .lt-heroband p { margin: 0; font-size: clamp(15px, 1.8vw, 18px); opacity: .95; max-width: 620px; }
    .lt-type { display: flex; gap: 26px; margin-top: 18px; }
    .lt-type button { background: none; box-shadow: none; color: #fff; padding: 4px 0; border-radius: 0; font-size: 15px; font-weight: 500; opacity: .85; border-bottom: 2px solid transparent; }
    .lt-type button.on { opacity: 1; font-weight: 700; border-bottom-color: #fff; }
    .lt-searchbar { position: relative; z-index: 2; margin: -48px auto 8px; width: calc(100% - 48px); max-width: 1040px; display: grid; grid-template-columns: 1.25fr 1.6fr 1fr auto; align-items: center; gap: 4px; padding: 10px 10px 10px 22px; border-radius: 999px; background: var(--lt-solid); border: 1px solid var(--divider); box-shadow: 0 18px 40px rgba(16, 24, 40, .14), 0 2px 6px rgba(16, 24, 40, .06); }
    .sb-field { position: relative; display: flex; align-items: center; gap: 12px; min-width: 0; padding: 4px 14px 4px 0; color: var(--muted); }
    .sb-field + .sb-field, .sb-dates, .sb-field.party { border-left: 1px solid var(--divider); padding-left: 16px; }
    .sb-dates { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .sb-dates .sb-field { flex: 1; padding-left: 0; border: 0; }
    .sb-arrow { color: var(--muted); flex: none; display: grid; }
    .sb-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; min-width: 0; flex: 1; text-align: left; }
    .sb-label { font-size: 15px; font-weight: 600; color: var(--text); }
    .lt-searchbar input { border: 0; background: none; box-shadow: none; padding: 0; border-radius: 0; font-size: 14px; color: var(--muted); width: 100%; min-width: 0; }
    .lt-searchbar input:focus { box-shadow: none; color: var(--text); }
    .lt-searchbar input::placeholder { color: var(--muted); }
    .lt-searchbar input[type=date]::-webkit-calendar-picker-indicator { opacity: .5; cursor: pointer; }
    .sb-near { flex: none; width: 34px; height: 34px; padding: 0; border-radius: 50%; background: var(--secondary); color: var(--muted); box-shadow: none; }
    .sb-near:hover, .sb-near.on { color: var(--brand); background: var(--brand-soft); }
    .sb-party { background: none; box-shadow: none; padding: 0; border-radius: 0; font-weight: 400; color: inherit; }
    .sb-value { font-size: 14px; color: var(--muted); white-space: nowrap; }
    .sb-pop { position: absolute; top: calc(100% + 14px); right: 0; z-index: 5; width: 250px; padding: 14px 16px; border-radius: 16px; background: var(--lt-solid); border: 1px solid var(--divider); box-shadow: 0 18px 40px rgba(16, 24, 40, .18); display: flex; flex-direction: column; gap: 10px; color: var(--text); }
    .sb-pop .step { display: grid; grid-template-columns: 1fr 32px 32px 32px; align-items: center; gap: 4px; text-align: center; }
    .sb-pop .step span { text-align: left; font-weight: 600; }
    .sb-pop .step button { width: 32px; height: 32px; padding: 0; border-radius: 50%; border: 1px solid var(--divider); background: none; box-shadow: none; font-size: 18px; }
    .sb-pop .link { align-self: flex-end; }
    .sb-go { border-radius: 999px; height: 56px; padding: 0 26px; font-size: 16px; }
    .lt-promos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 18px; }
    .lt-promo { border-radius: 22px; padding: 26px 28px; min-height: 170px; display: flex; align-items: center; gap: 18px; overflow: hidden; position: relative; }
    .lt-promo .text { display: flex; flex-direction: column; gap: 8px; flex: 1; align-items: flex-start; position: relative; }
    .lt-promo b { font-size: 24px; font-weight: 800; letter-spacing: -.01em; line-height: 1.15; }
    .lt-promo span { font-size: 15px; line-height: 1.45; }
    .lt-promo .kicker { font-weight: 700; font-size: 14px; }
    .lt-promo .art { flex: none; width: 112px; height: 112px; border-radius: 50%; display: grid; place-items: center; }
    .lt-promo.blue { background: linear-gradient(135deg, #1D4ED8, #3D7BF7 60%, #60A5FA); color: #fff; }
    .lt-promo.blue .kicker { color: #FDE68A; }
    .lt-promo.blue .art { background: rgba(255, 255, 255, .14); color: #fff; }
    .lt-promo.sun { background: linear-gradient(135deg, #FEF3C7, #FDE68A); color: #3B2A06; }
    .lt-promo.sun .art { background: rgba(124, 58, 237, .14); color: #6D28D9; }
    .lt-promo.sun button { background: #3B2A06; color: #FEF3C7; margin-top: 4px; }
    .lt h2.lt-section { font-size: clamp(24px, 3vw, 32px); font-weight: 800; text-align: center; letter-spacing: -.01em; margin: 34px 0 10px; }
    .lt-places { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .lt-place { position: relative; height: 240px; border-radius: 16px; overflow: hidden; padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: #fff; box-shadow: var(--shadow); transition: transform .2s ease, box-shadow .2s ease; }
    .lt-place:hover { transform: translateY(-3px); box-shadow: var(--shadow-strong); }
    .lt-place .shade { position: absolute; inset: 0; background: linear-gradient(rgba(10, 16, 40, .18), rgba(10, 16, 40, .5)); transition: background .2s ease; }
    .lt-place:hover .shade { background: linear-gradient(rgba(10, 16, 40, .3), rgba(10, 16, 40, .62)); }
    .lt-place .city, .lt-place .counts { position: relative; text-shadow: 0 1px 10px rgba(0, 0, 0, .35); padding: 0 14px; }
    .lt-place .city { font-size: 32px; font-weight: 500; letter-spacing: -.01em; }
    .lt-place .counts { font-size: 14px; font-weight: 500; }
    .lt-resultsbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
    .lt-resultsbar .grow { flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 2px; }
    .lt-resultsbar select { width: auto; }

    /* My trips, and empty or failed pages. */
    .lt-pagehead { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 10px 0 4px; }
    .lt-pagehead .grow { flex: 1; min-width: 220px; display: flex; flex-direction: column; gap: 4px; }
    .lt .lt-pagehead h2 { font-size: clamp(24px, 3vw, 30px); letter-spacing: -.01em; }
    .lt-empty { align-items: center; text-align: center; padding: 40px 24px; gap: 10px; background: var(--lt-solid); }
    .lt-empty p { margin: 0; max-width: 440px; }
    .lt-empty.small-empty { padding: 22px; }
    .lt-empty-icon { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; font-size: 34px; background: var(--brand-soft); margin-bottom: 4px; }
    .lt-count { display: inline-block; min-width: 22px; margin-left: 6px; padding: 1px 7px; border-radius: 10px; font-size: 12px; font-weight: 700; background: var(--secondary); }
    .lt-tabs button.on .lt-count { background: rgba(255, 255, 255, .25); }
    .lt-trips { display: flex; flex-direction: column; gap: 14px; }
    .lt-trip { display: grid; grid-template-columns: 76px 1fr auto; gap: 18px; align-items: center; padding: 16px 18px; border-radius: 16px; background: var(--lt-solid); border: 1px solid var(--divider); box-shadow: 0 1px 3px rgba(16, 24, 40, .08), 0 6px 18px rgba(16, 24, 40, .05); cursor: pointer; color: var(--text); outline: none; transition: transform .2s ease, box-shadow .2s ease; }
    .lt-trip:hover, .lt-trip:focus-visible { transform: translateY(-2px); box-shadow: var(--shadow-strong); }
    .lt-trip:focus-visible { box-shadow: 0 0 0 3px var(--brand); }
    .lt-trip .when { height: 84px; border-radius: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: linear-gradient(160deg, var(--brand), #7C3AED); line-height: 1.1; }
    .lt-trip .when.off { background: var(--secondary); color: var(--muted); }
    .lt-trip .when .m { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; opacity: .9; }
    .lt-trip .when .d { font-size: 30px; font-weight: 800; }
    .lt-trip .when .w { font-size: 12px; opacity: .85; }
    .lt-trip .what { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .lt-trip .what b { font-size: 17px; letter-spacing: -.01em; }
    .lt-trip .what .kind { font-size: 12px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: .04em; }
    .lt-trip .what .lt-note { margin-top: 6px; }
    .lt-trip .side { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .lt-trip .chev { font-size: 22px; color: var(--muted); line-height: 1; }
    .lt-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .lt-chips button { padding: 5px 11px; font-size: 13px; }
    .lt-chips button .n { opacity: .7; margin-left: 4px; font-size: 12px; }
    .lt-card { background: var(--glass-strong, var(--surface)); border: 1px solid var(--glass-border, var(--divider)); border-radius: 18px; box-shadow: var(--shadow, none); padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; color: var(--text); }
    .lt-search { display: grid; grid-template-columns: 2fr 1fr 1fr .7fr .7fr; gap: 8px; align-items: end; }
    .lt-field { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 700; color: var(--muted); min-width: 0; }
    .lt-field input, .lt-field select, .lt-field textarea { font-weight: 500; font-size: 15px; color: var(--text); }
    .lt-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .lt-three { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
    .lt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
    .lt-result { border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; background: var(--lt-solid); border: 1px solid var(--divider); box-shadow: 0 1px 3px rgba(16, 24, 40, .08), 0 6px 18px rgba(16, 24, 40, .05); cursor: pointer; color: var(--text); outline: none; transition: transform .2s ease, box-shadow .2s ease; }
    .lt-result:hover, .lt-result:focus-visible { transform: translateY(-3px); box-shadow: var(--shadow-strong); }
    .lt-result:focus-visible { box-shadow: 0 0 0 3px var(--brand); }
    .lt-result .photo { height: 210px; position: relative; }
    .lt-result .photo .tag { position: absolute; left: 12px; top: 12px; border-radius: 8px; padding: 4px 10px; font-size: 12px; font-weight: 700; background: rgba(0, 0, 0, .6); color: #fff; }
    .lt-result .photo .tag.off { background: rgba(229, 72, 77, .92); }
    .lt-result .photo .avatar { position: absolute; right: 14px; bottom: -17px; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--brand), #7C3AED); border: 2px solid var(--lt-solid); }
    .lt-result .body { padding: 18px 20px 18px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
    .lt-result .stars { color: var(--lt-star); letter-spacing: 2px; font-size: 14px; }
    .lt-result .kind { font-size: 12px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: .04em; }
    .lt-result .name { font-size: 18px; font-weight: 700; letter-spacing: -.01em; }
    .lt-result .where { font-size: 14px; color: var(--muted); }
    .lt-result .summary { font-size: 13px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .lt-result .foot { display: flex; gap: 6px; align-items: baseline; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--divider); }
    .lt-result .body > .foot { margin-top: auto; }
    .lt-result .body > .where, .lt-result .body > .summary { margin-bottom: 8px; }
    .lt-price { font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .lt-price small { font-size: 12px; color: var(--muted); font-weight: 600; }
    .lt-hero { border-radius: 20px; height: 220px; position: relative; overflow: hidden; }
    .lt-hero .over { position: absolute; inset: auto 0 0 0; padding: 18px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.65)); }
    .lt-hero .over h2 { color: #fff; }
    .lt-thumbs { display: flex; gap: 8px; overflow-x: auto; }
    .lt-thumbs img { width: 96px; height: 72px; object-fit: cover; border-radius: 10px; flex: none; cursor: pointer; }
    .lt-row { display: flex; gap: 10px; align-items: center; }
    .lt-row .grow { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .lt-row .grow small { color: var(--muted); }
    .lt-list > .lt-row { padding: 9px 0; border-bottom: 1px solid var(--divider); }
    .lt-list > .lt-row:last-child { border-bottom: none; }
    .lt-badge { display: inline-block; border-radius: 10px; padding: 2px 9px; font-size: 12px; font-weight: 800; background: var(--secondary); color: var(--muted); white-space: nowrap; }
    .lt-badge.ok { background: rgba(31, 169, 113, .16); color: var(--success); }
    .lt-badge.wait { background: rgba(255, 196, 0, .2); color: #8A6100; }
    .lt-badge.bad { background: rgba(229, 72, 77, .14); color: var(--danger); }
    .lt-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .lt-note { border-radius: 12px; padding: 10px 14px; font-size: 14px; background: var(--secondary); }
    .lt-note.warn { background: rgba(255, 196, 0, .18); color: #8A6100; }
    .lt-note.ok { background: rgba(31, 169, 113, .14); color: var(--success); }
    .lt-lines { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; font-size: 14px; }
    .lt-lines .total { font-weight: 800; font-size: 17px; border-top: 1px solid var(--divider); padding-top: 8px; }
    .lt-timer { font-variant-numeric: tabular-nums; font-weight: 800; }
    .lt-facts { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; font-size: 14px; }
    .lt-facts dt { color: var(--muted); }
    .lt-facts dd { margin: 0; overflow-wrap: anywhere; }
    .lt-voucher { align-items: center; text-align: center; }
    .lt-voucher img { width: min(280px, 80vw); image-rendering: pixelated; background: #fff; padding: 10px; border-radius: 14px; }
    .lt-bar-progress { height: 4px; border-radius: 2px; background: var(--secondary); width: min(280px, 80vw); overflow: hidden; }
    .lt-bar-progress div { height: 100%; background: var(--brand); transition: width 1s linear; }
    .lt-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .lt-stat { border-radius: 16px; padding: 12px 14px; background: var(--secondary); display: flex; flex-direction: column; gap: 2px; }
    .lt-stat b { font-size: 22px; font-variant-numeric: tabular-nums; }
    .lt-stat span { font-size: 12px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .lt-cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; font-size: 12px; }
    .lt-cal div { min-width: 0; overflow: hidden; }
    .lt-cal div { border-radius: 8px; padding: 6px 4px; background: var(--secondary); text-align: center; display: flex; flex-direction: column; gap: 2px; }
    .lt-cal div.closed { background: rgba(229, 72, 77, .14); }
    .lt-cal div.full { background: rgba(255, 196, 0, .2); }
    .lt-add { width: 96px; height: 72px; border-radius: 10px; border: 2px dashed var(--divider); display: grid; place-items: center; font-size: 24px; color: var(--muted); position: relative; overflow: hidden; cursor: pointer; flex: none; }
    .lt-add input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .lt-photo { position: relative; flex: none; }
    .lt-photo button { position: absolute; top: 2px; right: 2px; width: 22px; height: 22px; padding: 0; border-radius: 50%; background: rgba(0, 0, 0, .6); color: #fff; font-size: 13px; box-shadow: none; }
    @@media (max-width: 720px) { .lt-search { grid-template-columns: 1fr 1fr; } .lt-search .place { grid-column: 1 / -1; } }
    @@media (max-width: 900px) {
        .lt-searchbar { grid-template-columns: 1fr; border-radius: 22px; padding: 14px 16px; gap: 0; width: calc(100% - 24px); }
        .sb-field, .sb-dates, .sb-field.party { padding: 10px 0; border-left: 0; }
        .sb-field + .sb-field, .sb-dates, .sb-field.party { border-top: 1px solid var(--divider); padding-left: 0; }
        .sb-pop { left: 0; right: auto; }
        .sb-go { margin-top: 10px; height: 50px; }
        .lt-places { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
        .lt-promos { grid-template-columns: 1fr; }
    }
    @@media (max-width: 560px) {
        .lt-heroband { min-height: 260px; border-radius: 18px; }
        .lt-places { grid-template-columns: 1fr; }
        .lt-place { height: 180px; }
        .lt-promo .art { display: none; }
        .sb-dates .lt-icon { display: none; }
        .lt-trip { grid-template-columns: 60px 1fr; gap: 14px; padding: 14px; }
        .lt-trip .when { height: 70px; }
        .lt-trip .when .d { font-size: 24px; }
        .lt-trip .side { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; }
        .lt-trip .chev { display: none; }
        .lt-nav .brand span { display: none; }
    }
    @@media (max-width: 480px) { .lt-two, .lt-three { grid-template-columns: 1fr; } .lt-cal { font-size: 10px; gap: 2px; } .lt-cal div { padding: 4px 1px; } }
</style>

<div class="lt">
    <header class="bar lt-bar">
        <button class="bar-back link" title="Back" @onclick="BackAsync">‹</button>
        <h1>@Title</h1>
    </header>

    <div class="page">
        @if (_view is TravelView.Explore or TravelView.Trips or TravelView.Vendor)
        {
            <div class="lt-nav">
                <span class="brand"><i aria-hidden="true">✈</i><span>Lets Travel</span></span>
                <nav aria-label="Lets Travel">
                    <button class="@(_view is TravelView.Explore ? "on" : "")" aria-current="@(_view is TravelView.Explore ? "page" : null)" @onclick="() => Go(new TravelView.Explore(), root: true)">Explore</button>
                    <button class="@(_view is TravelView.Trips ? "on" : "")" aria-current="@(_view is TravelView.Trips ? "page" : null)" @onclick="() => Go(new TravelView.Trips(), root: true)">My trips</button>
                    <button class="@(_view is TravelView.Vendor ? "on" : "")" aria-current="@(_view is TravelView.Vendor ? "page" : null)" @onclick="() => Go(new TravelView.Vendor(), root: true)">For vendors</button>
                </nav>
            </div>
        }

        <CascadingValue Value="this" IsFixed="true">
            @switch (_view)
            {
                case TravelView.Explore: <Explore /> break;
                case TravelView.Property p: <PropertyPage @key="p" View="p" /> break;
                case TravelView.Tour t: <TourPage @key="t" View="t" /> break;
                case TravelView.Checkout c: <Checkout @key="c" HoldId="c.HoldId" /> break;
                case TravelView.Trips: <Trips /> break;
                case TravelView.Booking b: <BookingPage @key="b" Id="b.Id" /> break;
                case TravelView.Voucher v: <VoucherPage @key="v" Id="v.Id" /> break;
                case TravelView.Vendor v: <VendorPortal @key="v" Tab="@v.Tab" /> break;
                case TravelView.EditProperty e: <EditProperty @key="e" Id="e.Id" /> break;
                case TravelView.EditTour e: <EditTour @key="e" Id="e.Id" /> break;
            }
        </CascadingValue>
    </div>
</div>

@code {
    [CascadingParameter] public SubAppContext Context { get; set; } = null!;

    TravelView _view = new TravelView.Explore();
    readonly Stack<TravelView> _history = new();
    IAsyncDisposable? _subscription;

    public TravelApi Api { get; private set; } = null!;
    public TravelMeDto? Me { get; private set; }

    /// <summary>Why <see cref="Me"/> couldn't be loaded, so pages that need it can say so instead of waiting.</summary>
    public string? MeError { get; private set; }

    /// <summary>The last search, kept while browsing results and listings.</summary>
    public TravelSearchRequest Search { get; set; } = new(TravelItemTypes.Stay);

    /// <summary>Raised when a booking of theirs (or, as a vendor, one they received) changes, live.</summary>
    public event Action? Changed;

    /// <summary>Raised when <see cref="Me"/> (or <see cref="MeError"/>) arrives, for pages rendered before it did.</summary>
    public event Action? MeChanged;

    protected override async Task OnInitializedAsync()
    {
        Api = new TravelApi(Context.Api);
        var query = Context.Query.Split('&').Select(p => p.Split('=', 2)).Where(p => p.Length == 2)
            .GroupBy(p => p[0]).ToDictionary(g => g.Key, g => g.First()[1]);
        if (query.TryGetValue("booking", out var b) && Guid.TryParse(b, out var booking))
            Go(new TravelView.Booking(booking));
        else if (query.TryGetValue("property", out var p) && Guid.TryParse(p, out var property))
            Go(new TravelView.Property(property, null, null, 2, 1));
        else if (query.TryGetValue("tour", out var t) && Guid.TryParse(t, out var tour))
            Go(new TravelView.Tour(tour, 2));

        if (Context.Realtime is { } realtime)
        {
            try
            {
                _subscription = await realtime.SubscribeAsync(TravelContract.Topic(Context.UserId), _ => InvokeAsync(() => Changed?.Invoke()));
            }
            catch (Exception)
            {
                // Live updates are a nicety: pages show the latest when they load.
            }
        }
        await RefreshMeAsync();
    }

    public async Task RefreshMeAsync()
    {
        try
        {
            Me = await Api.GetAsync<TravelMeDto>($"{TravelApi.Base}/me");
            MeError = null;
        }
        catch (TravelException e)
        {
            MeError = e.Message;
        }
        StateHasChanged();
        MeChanged?.Invoke();
    }

    string Title => _view switch
    {
        TravelView.Checkout => "Checkout",
        TravelView.Booking or TravelView.Voucher => "Your booking",
        TravelView.Vendor or TravelView.EditProperty or TravelView.EditTour => "Vendor portal",
        _ => "Lets Travel"
    };

    public void Go(TravelView view, bool root = false)
    {
        if (root)
            _history.Clear();
        else
            _history.Push(_view);
        _view = view;
        StateHasChanged();
    }

    public void Replace(TravelView view)
    {
        _view = view;
        StateHasChanged();
    }

    public Task BackAsync()
    {
        if (_history.TryPop(out var previous))
        {
            _view = previous;
            StateHasChanged();
            return Task.CompletedTask;
        }
        return _view is TravelView.Explore ? Context.NavigateToLauncher() : Task.Run(() => InvokeAsync(() => Go(new TravelView.Explore(), root: true)));
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscription is not null)
            await _subscription.DisposeAsync();
    }
}
